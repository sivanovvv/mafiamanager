<ips:template parameters="$data" />
<i-data>
	<ul class="ipsData ipsData--table ipsData--dashboard-overview">
		{{foreach $data as $k => $v}}
			<li class="ipsData__item">
				<span class="i-basis_180">
					<strong>{lang="$k"}</strong>
				</span>
				<span class="">
					{$v}
				</span>
			</li>
		{{endforeach}}
	</ul>
</i-data>