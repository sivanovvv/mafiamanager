<ips:template parameters="$event, $reminder=NULL, $buttonClass=''" />
{{if member.member_id}}
	{{if $reminder}}
		<a class="ipsButton ipsButton--primary ipsButton--small {$buttonClass}" data-role="reminderButton" data-reminder="true" href="{url="app=calendar&module=calendar&controller=event&id={$event->id}&do=setReminder" csrf="true"}" title="{lang="event_edit_reminder"}" data-ipsTooltip data-ipsHover data-ipsHover-cache='false' data-ipsHover-onClick><i class='fa-solid fa-bell' aria-hidden="true"></i> {lang="event_edit_reminder"} <i class='fa-solid fa-caret-down' aria-hidden="true"></i></a>
	{{else}}
		<a class="ipsButton ipsButton--inherit ipsButton--small {$buttonClass}" data-role="reminderButton" data-reminder="false" href="{url="app=calendar&module=calendar&controller=event&id={$event->id}&do=setReminder" csrf="true"}" title="{lang="event_set_reminder_tip"}" data-ipsTooltip data-ipsHover data-ipsHover-cache='false' data-ipsHover-onClick><i class='fa-solid fa-bell' aria-hidden="true"></i> {lang="event_set_reminder"}</a>
	{{endif}}
{{endif}}