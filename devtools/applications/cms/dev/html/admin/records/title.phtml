<ips:template parameters="$row, $title" />
{{if $row['record_future_date'] or $row['record_approved'] === -1 or $row['record_approved'] === 0 or $row['record_pinned'] === 1 or $row['record_featured'] === 1}}
	<span class=''>
	{{if $row['record_future_date']}}
		{{$time  = \IPS\DateTime::ts( $row['record_publish_date'] );}}
		<span class="ipsBadge ipsBadge--icon ipsBadge--small ipsBadge--warning" data-ipsTooltip title='{lang="content_future_date_blurb" sprintf="$time->localeDate(), $time->localeTime()"}'><i class='fa-regular fa-clock' aria-hidden="true"></i></span>
	{{endif}}
	{{if $row['record_approved'] === -1}}
		<span class="ipsBadge ipsBadge--icon ipsBadge--small ipsBadge--warning"><i class='fa-solid fa-eye-slash' aria-hidden="true"></i></span>
	{{endif}}
	{{if $row['record_approved'] === 0}}
		<span class="ipsBadge ipsBadge--icon ipsBadge--small ipsBadge--warning" data-ipsTooltip><i class='fa-solid fa-triangle-exclamation' aria-hidden="true"></i></span>
	{{endif}}
	{{if $row['record_pinned'] === 1}}
		<span class="ipsBadge ipsBadge--icon ipsBadge--small ipsBadge--positive" data-ipsTooltip title='{lang="pinned"}'><i class='fa-solid fa-thumbtack' aria-hidden="true"></i></span>
	{{endif}}
	{{if $row['record_featured'] === 1}}
		<span class="ipsBadge ipsBadge--icon ipsBadge--small ipsBadge--positive" data-ipsTooltip title='{lang="featured"}'><i class='fa-solid fa-star' aria-hidden="true"></i></span>
	{{endif}}
	</span>
{{endif}}
{$title}