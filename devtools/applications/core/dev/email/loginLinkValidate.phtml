<ips:template parameters="$member, $vid, $securityKey, $email" />
{$email->language->addToStack('email_loginlink_validate')}
<br><br>
<table width='100%' cellpadding='15' cellspacing='0' border='0' style='background: #f9f9f9;' class="background_2">
	<tr>
		<td dir='{dir}' align='center'>
			<a href='{url="app=core&module=system&controller=register&do=validate&vid={$vid}&mid={$member->member_id}&security_key={$securityKey}" base="front"}' style="color: #ffffff; font-family: system-ui, 'Helvetica Neue', helvetica, sans-serif; text-decoration: none; font-size: 14px; background-color: {setting="email_color"}; line-height: 36px; padding: 0 16px; display: inline-block; border-radius: 6px; font-weight: 600;" class="button">{$email->language->addToStack("email_validate_link", FALSE)}</a>
		</td>
	</tr>
</table>
<br><br>
<em class="color_soft" style="color:#4b4b4b;">&mdash; {setting="board_name"}</em>