<ips:template parameters="$message, $email" />
{{$emailContent = $email->parseTextForEmail( $message->post, $email->language, ( \IPS\Settings::i()->email_truncate ? 200 : NULL ) );}}
{$email->language->addToStack("messenger_notify_title", FALSE, array( 'sprintf' => array( $message->author()->name ) ) )}
<br><br>
{{if !$emailContent}}
	<a href='{$message->url()}' style="color: #ffffff; font-family: system-ui, 'Helvetica Neue', helvetica, sans-serif; text-decoration: none; font-size: 12px; background-color: {setting="email_color"}; line-height: 36px; padding: 0 16px; display: inline-block; border-radius: 6px; font-weight: 600;" class="button">{$email->language->addToStack("messenger_inline_button", FALSE)}</a>
	<br><br>
{{endif}}
<em class="color_soft" style="color:#4b4b4b;">&mdash; {setting="board_name"}</em>
<br><br>
<div style='height: 1px; background: #dcdcdc;' class="hr"></div>
<br><br>
{{if $emailContent}}
	<table width='100%' cellpadding='0' cellspacing='0' border='0'>
		<tr>
			<td dir='{dir}' width='75' valign='top' class='hidePhone'>
				<img src='{$message->author()->get_photo( true, true )}' width='55' height='55' style='border-radius: 6px;' class="avatar">
			</td>
			<td dir='{dir}' valign='top'>
				<h2 style='margin: 0 0 15px 0; font-size: 19px; font-weight: 500; color: #000;' class="color_hard">{$message->item()->title}</h2>
				<div style='line-height: 1.5; margin-bottom: 25px;'>
					{$emailContent|raw}{{if \IPS\Settings::i()->email_truncate}}...{{endif}}
				</div>
				<a href='{$message->url()}' style="color: #ffffff; font-family: system-ui, 'Helvetica Neue', helvetica, sans-serif; text-decoration: none; font-size: 12px; background-color: {setting="email_color"}; line-height: 36px; padding: 0 16px; display: inline-block; border-radius: 6px; font-weight: 600;" class="button">{$email->language->addToStack("messenger_inline_button", FALSE)}</a>
			</td>
		</tr>
	</table>
{{else}}
	<table width='100%' cellpadding='15' cellspacing='0' border='0' style='background: #f5f5f5;' class="background_2">
		<tr>
			<td dir='{dir}'>
				<h2 style='margin: 0; font-size: 19px; font-weight: 500'>{$message->item()->title}</h2>
			</td>
		</tr>
	</table>
{{endif}}
<br><br>
<table width='100%' cellpadding='10' cellspacing='0' border='0'>
	<tr>
		<td dir='{dir}'>
			<strong>{$email->language->addToStack("members_in_convo", FALSE, array( 'pluralize' => array( $message->item()->activeParticipants ) ) )}</strong>
		</td>
	</tr>
	<tr>
		<td dir='{dir}'>
			<table width='100%' cellpadding='0' cellspacing='0' border='0' class='responsive_table'>
				{{$i = 0;}}
				{{foreach $message->item()->maps() as $map}}
					{{if $map['map_user_active']}}
						{{if ( $i % 4 ) == 0}}
							<tr>
						{{endif}}
						<td dir='{dir}' width='200' class='responsive_row'>
							<table width='100%' cellpadding='0' cellspacing='0' border='0'>
								<tr>
									<td dir='{dir}' width='50'>
										<img src='{expression="\IPS\Member::load( $map['map_user_id'] )->get_photo( true, true )"}' width='40' height='40' style='border-radius: 6px;' class="avatar">
									</td>
									<td dir='{dir}'>
										<strong style="color: #000; font-weight: 600;" class="color_hard">{member="name" id="$map['map_user_id']"}</strong><br>
										{{$mapGroup = \IPS\Member\Group::constructFromData( \IPS\Member::load( $map['map_user_id'] )->group );}}
										<span style='font-size: 13px; color: #4b4b4b;' class="color_soft">{expression="$mapGroup->formatName( $email->language->addToStack( 'core_group_' . $mapGroup->g_id ) )" raw="true"}</span>
									</td>
								</tr>
							</table>
						</td>
						{{if ( ( $i + 1 ) % 4 ) == 0}}
							</tr>
						{{endif}}
						{{$i++;}}
					{{endif}}
				{{endforeach}}
				{{while ( ( ( $i ) % 4 ) != 0 ):}}
					<td dir='{dir}'>&nbsp;</td>
					{{if ( ( $i + 1 ) % 4 ) == 0}}
						</tr>
					{{endif}}
					{{$i++;}}
				{{endwhile;}}
			</table>
		</td>
	</tr>
</table>