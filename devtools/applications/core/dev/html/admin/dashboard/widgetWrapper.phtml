<ips:template parameters="$blockHtml, $info, $collapsed=array()" />

<li data-widgetKey='{$info['key']}' data-widgetName='{$info['name']}'>
	<div class='ipsBox acpWidget_item' data-ips-template="widgetWrapper">
		<h2 class='ipsBox__header' data-widgetCollapse>
			<span>
				<i class='fa-solid fa-{{if \in_array( $info['key'], $collapsed )}}caret-right{{else}}caret-down{{endif}}' aria-hidden="true"></i> {lang="block_{$info['key']}"}
			</span>
			<ul class='acpWidget_tools'>
				<li>
					<a href='#' class='acpWidget_reorder ipsJS_show i-cursor_move' data-ipsTooltip title='{lang="reorder_widget"}'><i class="fa-solid fa-arrows-up-down-left-right" aria-hidden="true"></i></a>
				</li>
				<li>
					<a href='#' class='acpWidget_close' data-ipsTooltip title='{lang="close_widget"}'><i class='fa-solid fa-xmark' aria-hidden="true"></i></a>
				</li>
			</ul>
		</h2>
		<div data-role="widgetContent" data-widgetCollapsed='{{if \in_array( $info['key'], $collapsed )}}true{{else}}false{{endif}}' data-widgetCollapse-content>
			{$blockHtml|raw}
		</div>
	</div>
</li>