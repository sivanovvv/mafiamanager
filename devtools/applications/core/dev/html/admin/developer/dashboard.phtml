<ips:template parameters="$app" />
<div class='ipsBox i-padding_2 i-margin-bottom_1'>
    <h3 class='ipsTitle ipsTitle--h3'>{$app->_title}</h3>
    <div class='i-border-bottom_2 i-padding-bottom_1'>
        {$app->author}{{if $app->website}} <a href='{$app->website}' target='_blank' rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square-square" title='{$app->website}' aria-hidden="true"></i></a>{{endif}}
    </div>
    <div class='ipsClearix i-padding-top_2'>
        <a href='{url="app=core&module=developer&controller=versions&appKey={$app->directory}&do=addVersion"}' class='ipsButton ipsButton--primary ipsButton--tiny i-float_end'>{lang="versions_add"}</a>
        {lang="app_details_app_version"}: {lang="app_version_string" sprintf="$app->version, $app->long_version"}
    </div>
</div>
<div class='ipsBox i-padding_2 i-margin-bottom_1' data-role="devCenterIssues">
    <div class='ipsClearfix'>
        <div class='elBlockTitle i-padding_1 i-flex i-align-items_center i-justify-content_space-between i-border-bottom_3'>
            <div>
                <h2 class='i-font-size_2 i-font-weight_600 i-color_hard'>{lang="devscan_title"}</h2>
            </div>
            <div>
                <span class='i-color_warning ipsHide' data-iconType="critical"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span>
                <span class='i-color_issue ipsHide' data-iconType="recommended"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></span>
            </div>
        </div>
        <div data-role="devCenterIssues_content"></div>
    </div>
</div>
<div class='ipsGrid ipsGrid--2'>
    {{foreach array( 'admin', 'front' ) as $location}}
    <section class='ipsWidget'>
        <header class='ipsWidget__header i-flex i-align-items_center'>
            <div class="i-flex_11">{lang="menu__core_developer_{$location}_modules{$location}"}</div>
            <a href='{url="app=core&module=developer&controller=modules&appKey={$app->directory}&location={$location}&do=moduleForm"}' class='ipsButton ipsButton--icon ipsButton--tiny ipsButton--inherit' title='{lang="modules_add"}' data-ipsTooltip><i class='fa-solid fa-plus-circle' aria-hidden="true"></i></a>
        </header>
        <i-data>
            <ol class="ipsData ipsData--table ipsData--compact ipsData--dashboard">
                {{foreach $app->modules( $location ) as $module}}
                    <li class='ipsData__item'>
                        <div class='ipsData__main'>
                            {$module->key}
                        </div>
                        <a href='{url="app=core&module=developer&controller=modules&appKey={$app->directory}&location={$location}&do=addController&module_key={$module->key}"}' class='ipsButton ipsButton--icon ipsButton--tiny ipsButton--inherit i-flex_00' title='{lang="modules_add_controller"}' data-ipsTooltip><i class='fa-solid fa-plus-circle' aria-hidden="true"></i></a>
                    </li>
                {{endforeach}}
            </ol>
        </i-data>
    </section>
    {{endforeach}}
</div>