<ips:template parameters="$id, $action, $tabs, $activeTab, $error, $errorTabs, $hiddenValues, $actionButtons, $uploadField, $sidebar, $tabClasses=array(), $formClass='', $attributes=array(), $tabArray=array(), $usingIcons=FALSE" />
<div>
	{{if $error}}
		<div class="ipsMessage ipsMessage--error i-margin-bottom_1">
			{$error}
		</div>
	{{endif}}
	{{if !empty( $errorTabs )}}
		<p class="ipsMessage ipsMessage--error ipsJS_show i-margin-bottom_1">{lang="tab_error"}</p>
	{{endif}}
	{{if !\IPS\Request::i()->isAjax() }}<div class="ipsBox ipsPull">{{endif}}
		<form accept-charset='utf-8' data-formId="{$id}" action="{$action}" method="post" {{if $uploadField}}enctype="multipart/form-data"{{endif}} data-ipsForm class="ipsFormWrap ipsFormWrap--admin-template" {{foreach $attributes as $k => $v}}{$k}="{$v}"{{endforeach}} {{if \count($tabArray) > 1}}novalidate="true"{{endif}}>
			<input type="hidden" name="{$id}_activeTab" value="{{if $activeTab}}{$activeTab}{{endif}}">
			<input type="hidden" name="{$id}_submitted" value="1">
			{{foreach $hiddenValues as $k => $v}}
				{{if \is_array($v)}}
					{{foreach $v as $_v}}
						<input type="hidden" name="{$k}[]" value="{$_v}">
					{{endforeach}}
				{{else}}
					<input type="hidden" name="{$k}" value="{$v}">
				{{endif}}
			{{endforeach}}
			{{if $uploadField}}
				<input type="hidden" name="MAX_FILE_SIZE" value="{$uploadField}">
			{{endif}}
			{{if \count( $tabs ) === 1}}
				{{if !empty( $sidebar )}}
					<div class='ipsColumns'>
						<div class='ipsColumns__primary'>
				{{endif}}
							<ul class='ipsForm {$formClass} ipsForm--admin-template'>
								{expression="array_pop( $tabs )" raw="true"}
							</ul>
				{{if !empty( $sidebar )}}
						</div>
						<div class='ipsColumns__secondary i-basis_280'>
							{expression="array_pop( $sidebar )" raw="true"}
						</div>
					</div>
				{{endif}}
			{{else}}
				<i-tabs class='ipsTabs acpFormTabBar{{if $usingIcons}} ipsTabs--withIcons{{endif}}' id='ipsTabs_{$id}' data-ipsTabBar data-ipsTabBar-contentArea='#ipsTabs_{$id}_content'>
					<div role='tablist'>
						{{foreach $tabs as $name => $content}}
							<button type="button" id='ipsTabs_{$id}_{$name}' class="ipsTabs__tab {{if \in_array( $name, $errorTabs )}}ipsTabs__tab--error{{endif}}" role="tab" aria-controls="ipsTabs_{$id}_{$name}_panel" aria-selected="{{if $activeTab == $name}}true{{else}}false{{endif}}">
								{{if \in_array( $name, $errorTabs )}}<i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> {{endif}}{{if isset($tabArray[$name]['icon'])}}<i class='fa-solid fa-{$tabArray[$name]['icon']}' aria-hidden="true"></i> {{endif}}{lang="$name"}
							</button>
						{{endforeach}}
					</div>
					{template="tabScrollers" app="core" group="global" location="global"}
				</i-tabs>
				<div id='ipsTabs_{$id}_content' class='acpFormTabContent'>
					{{foreach $tabs as $name => $contents}}
						<div class="ipsTabs__panel" role="tabpanel" id='ipsTabs_{$id}_{$name}_panel' aria-labelledby="ipsTabs_{$id}_{$name}" {{if !$activeTab != $name}}hidden{{endif}}>
							{{if isset( $sidebar[ $name ] )}}
								<div class='ipsColumns'>
									<div class='ipsColumns__primary'>
							{{endif}}
										<ul class='ipsForm {$formClass} ipsForm--admin-template {{if isset( $tabClasses[ $name ] )}}{$tabClasses[ $name ]}{{endif}}'>
											{$contents|raw}
										</ul>
							{{if isset( $sidebar[ $name ] )}}
									</div>
									<div class='ipsColumns__secondary i-basis_280'>
										{$sidebar[ $name ]|raw}
									</div>
								</div>
							{{endif}}
						</div>
					{{endforeach}}
				</div>
			{{endif}}
			<div class="ipsSubmitRow">
				{expression="implode( '', $actionButtons)" raw="true"}
			</div>
		</form>
	{{if !\IPS\Request::i()->isAjax() }}</div>{{endif}}
</div>