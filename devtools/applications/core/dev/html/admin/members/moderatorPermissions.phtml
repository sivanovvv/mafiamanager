<ips:template parameters="$id, $action, $tabs, $hiddenValues, $actionButtons, $uploadField, $formClass='', $attributes=array(), $sidebar=NULL, $form=NULL, $errorTabs=NULL" />
<div data-controller='core.admin.members.moderatorPermissions' class="ipsBox">
	<form accept-charset='utf-8' data-formId="{$id}" action="{$action}" method="post" {{if $uploadField}}enctype="multipart/form-data"{{endif}} data-ipsForm class="ipsFormWrap ipsFormWrap--moderator-permissions {$formClass}" {{foreach $attributes as $k => $v}}{$k}="{$v}"{{endforeach}}>
		<input type="hidden" name="{$id}_submitted" value="1">
		{{foreach $hiddenValues as $k => $v}}
			{{if \is_array($v)}}
				{{foreach $v as $_v}}
					<input type="hidden" name="{$k}[]" value="{$_v}">
				{{endforeach}}
			{{else}}
				<input type="hidden" name="{$k}" value="{$v}">
			{{endif}}
		{{endforeach}}
		{{if $uploadField}}
			<input type="hidden" name="MAX_FILE_SIZE" value="{$uploadField}">
		{{endif}}
		<div class='acpFormTabContent'>
			<ul class='ipsForm {$formClass} ipsForm--admin-template ipsForm--moderator-permissions'>
				{{foreach $tabs[''] as $input}}
					{$input->rowHtml( $form )|raw}
				{{endforeach}}
			</ul>
		</div>
		<div id='permission_form_wrapper'>
			<!-- <ul class="ipsButtons">
				<li><a href="#" class="ipsButton ipsButton--inherit ipsButton--tiny" data-role="checkAll">{lang="check_all"}</a></li>
				<li><a href="#" class="ipsButton ipsButton--inherit ipsButton--tiny" data-role="uncheckAll">{lang="uncheck_all"}</a></li>
			</ul> -->
			<div class=''>
				{{if $form->error}}
					<div class="ipsMessage ipsMessage--error">
						{$form->error}
					</div>
				{{endif}}
				{{if !empty( $errorTabs )}}
					<p class="ipsMessage ipsMessage--error">{lang="tab_error"}</p>
				{{endif}}
				<i-tabs class='ipsTabs i-background_2 acpFormTabBar' id='ipsTabs_{$id}' data-ipsTabBar data-ipsTabBar-contentArea='#ipsTabs_{$id}_content'>
					<div role='tablist'>
						{{$checkedTab = NULL;}}
						{{foreach $tabs as $name => $content}}
							{{if $name}}
								<button type="button" id='ipsTabs_{$id}_{$name}' class="ipsTabs__tab {{if \in_array( $name, $errorTabs )}}ipsTabs__tab--error{{endif}}" role="tab" aria-controls="ipsTabs_{$id}_{$name}_panel" aria-selected="{{if !$checkedTab}}true{{$checkedTab = $name;}}{{else}}false{{endif}}">
									{{if \in_array( $name, $errorTabs )}}<i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> {{endif}}{lang="$name"}
								</button>
							{{endif}}
						{{endforeach}}
					</div>
					{template="tabScrollers" app="core" group="global" location="global"}
				</i-tabs>
				<div id='ipsTabs_{$id}_content' class='acpFormTabContent'>
					{{foreach $tabs as $name => $collection}}
						{{if $name}}
							<div id='ipsTabs_{$id}_{$name}_panel' class="ipsTabs__panel" role="tabpanel" aria-labelledby="ipsTabs_{$id}_{$name}" {{if $checkedTab != $name}}hidden{{endif}}>
								<ul class='ipsForm {$formClass} ipsForm--admin-template ipsForm--moderator-permissions'>
									{{foreach $collection as $input}}
										{$input->rowHtml( $form )|raw}
									{{endforeach}}
								</ul>
							</div>
						{{endif}}
					{{endforeach}}
				</div>
			</div>
		</div>
		<div class="ipsSubmitRow">
			{expression="implode( '', $actionButtons )" raw="true"}
		</div>
	</form>
</div>