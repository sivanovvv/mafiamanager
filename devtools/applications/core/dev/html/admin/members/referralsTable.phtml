<ips:template parameters="$customer, $table, $title, $type" />
<div class="ipsBox" data-ips-template="referralsTable">
	{{$count = \count( $table->getRows(NULL) );}}
	<h3 class='ipsBox__header'>
		<i class="fa-solid fa-user-plus ipsBox__header-icon" aria-hidden="true"></i>
		<span>{$title}</span>
	</h3>
	<div class="ipsBox__content">
		{$table|raw}
		<div class="ipsViewAll">
			<a href='{url="app=core&module=members&controller=members&do=editBlock&block=IPS\\core\\extensions\\core\\MemberACPProfileBlocks\\Referrals&id={$customer->member_id}"}' data-ipsDialog data-ipsDialog-title='{lang="customer_tab_{$type}"}'>
				{lang="customer_manage_{$type}"}
			</a>
		</div>
	</div>
</div>