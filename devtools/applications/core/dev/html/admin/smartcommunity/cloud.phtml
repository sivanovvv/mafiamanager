<ips:template parameters="" />

<!-- Top bit -->
<div class="i-padding_3 ipsBox i-margin-bottom_2">
    <h3 class="ipsTitle ipsTitle--h3">
        {lang="cloud_smart_community_title"}
    </h3>
    <p class="i-color_soft">
        {lang="cloud_smart_community_desc"}
    </p>
</div>
<div class="ipsGrid i-basis_320">
    <!-- IMAGE SCANNER -->
	<div class="ipsSpanGrid__6">
        <div class="">
            <div class="ipsBox acpEnhancement">
                <div class="acpEnhancement__title">
                    <h3>{lang="cloud_ai_service_imagescan"} <span class="ipsBadge ipsBadge--neutral i-float_end">{lang="only_available_on_cloud"}</span></h3>
                </div>
                <div class="ipsRichText">
                    <p>{lang="cloud_ai_service_imagescan_desc"}</p>
                </div>
            </div>
        </div>
    </div>
    <!-- TRENDING -->
    <div class="ipsSpanGrid__6">
        <div class="">
            <div class="ipsBox acpEnhancement">
                <div class="acpEnhancement__title">
                    <h3>{lang="cloud_ai_service_trending"} &nbsp; <span class="ipsBadge ipsBadge--neutral i-float_end">{lang="only_available_on_cloud"}</span></h3>
                </div>
                <div class="ipsRichText">
                    <p>{lang="cloud_ai_service_trending_desc"}</p>
                </div>
            </div>
        </div>
    </div>
    <!-- REALTIME -->
    <div class="ipsSpanGrid__6">
        <div class="">
            <div class="ipsBox acpEnhancement">
                <div class="acpEnhancement__title">
                    <h3>
                        {lang="cloud_ai_service_realtime"} &nbsp; <span class="ipsBadge ipsBadge--neutral i-float_end">{lang="only_available_on_cloud"}</span>
                    </h3>
                </div>
                <div class="ipsRichText">
                    <p>{lang="cloud_ai_service_realtime_desc"}</p>
                </div>
            </div>
        </div>
    </div>
</div>
<div>
	<a href="{url="switch_to_cloud" ips="true"}" target="_blank" class="ipsButton ipsButton--wide ipsButton--primary">{lang="learn_more"}</a>
</div>