<ips:template parameters="$output, $js" />
<!DOCTYPE html>
<html lang="{expression="\IPS\Member::loggedIn()->language()->bcp47()"}" dir="{{if member.language()->isrtl}}rtl{{else}}ltr{{endif}}" {template="htmlDataAttributes" app="core" group="global" location="front" params=""}
	data-ips-embed
    style="background-color: var(--i-background_1);"
>
	<head>
		{template="prefersColorSchemeLoad" app="core" group="global" location="front" params=""}
		{template="includeCSS" app="core" group="global" location="global" params=""}

		<script>
			var ipsDebug = {{if ( \IPS\IN_DEV and \IPS\DEV_DEBUG_JS ) or \IPS\DEBUG_JS}}true{{else}}false{{endif}};
		</script>

		{{if \is_array( $js )}}
			{{foreach $js as $jsInclude}}
				{{$filename = \IPS\Http\Url::external( $jsInclude[0] );}}
				<script src='{$filename}'></script>
			{{endforeach}}
		{{endif}}
	</head>
	<body class='unloaded' data-role='externalEmbed'>
		<div id='ipsEmbed'>
			{$output|raw}
		</div>
		<div id='ipsEmbedLoading'>
			<span></span>
		</div>
	</body>
</html>
