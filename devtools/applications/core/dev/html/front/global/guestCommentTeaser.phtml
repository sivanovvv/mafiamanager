<ips:template parameters="$item, $isReview=FALSE" />

<div>
	<input type="hidden" name="csrfKey" value="{expression="\IPS\Session::i()->csrfKey"}">
	{{if \IPS\Login::registrationType() != 'disabled'}}
		<div class='i-text-align_center cGuestTeaser'>
			{{if $isReview}}
				<h2 class='ipsTitle ipsTitle--h4'>{lang="teaser_review_title_reg"}</h2>
			{{else}}
				<h2 class='ipsTitle ipsTitle--h4'>{lang="teaser_title_reg"}</h2>
			{{endif}}
	
			<div class='ipsFluid i-basis_260 i-margin-top_3'>
				<div>
					{{if \IPS\Login::registrationType() == 'redirect'}}
						<a href='{expression="\IPS\Settings::i()->allow_reg_target"}' class='ipsButton ipsButton--primary ipsButton--wide' target="_blank" rel="noopener">
					{{else}}
						<a href='{url="app=core&module=system&controller=register" seoTemplate="register"}' class='ipsButton ipsButton--primary ipsButton--wide' {{if \IPS\Login::registrationType() == 'normal'}}data-ipsDialog data-ipsDialog-size='narrow' data-ipsDialog-title='{lang="sign_up"}'{{endif}}>
					{{endif}}
					{lang="teaser_account_button"}</a>
				</div>
				<div>
					<a href='{url="app=core&module=system&controller=login" seoTemplate="login" ref="(string) $item->url() . '#replyForm'"}' data-ipsDialog data-ipsDialog-size='medium' data-ipsDialog-remoteVerify="false" data-ipsDialog-title="{lang="teaser_signin_button"}" class='ipsButton ipsButton--secondary ipsButton--wide'>{lang="teaser_signin_button"}</a>
				</div>
			</div>
		</div>
	{{else}}
		<div class='i-text-align_center'>
			<h2 class='ipsTitle ipsTitle--h4'>{lang="teaser_title_noreg"}</h2>
			<p class='i-color_soft i-margin-top_1'>{lang="teaser_desc_noreg"}</p>
			<a href='{url="app=core&module=system&controller=login" seoTemplate="login" ref="(string) $item->url() . '#replyForm'"}' data-ipsDialog data-ipsDialog-size='medium' data-ipsDialog-remoteVerify="false" data-ipsDialog-title="{lang="teaser_signin_button"}" class='ipsButton ipsButton--primary i-margin-top_3'>{lang="teaser_signin_button"}</a>
		</div>
	{{endif}}
</div>