<ips:template parameters="$member" />
{{if $member->canEditSignature() AND !\IPS\Member::loggedIn()->isIgnoring( $member, 'signatures' ) AND \IPS\Member::loggedIn()->members_bitoptions['view_sigs']}}
	<div data-role="memberSignature" class='ipsEntry__signature {{if !settings.signatures_mobile}}ipsResponsive_hidePhone{{endif}}'>
		{{if \IPS\Member::loggedIn()->member_id}}
			{{$uniqid = mt_rand();}}
			<div class='i-float_end'>
				<button type="button" id="elSigIgnore{$uniqid}" popovertarget="elSigIgnore{$uniqid}_menu" data-memberID="{$member->member_id}" data-role='signatureOptions' class='i-color_soft' data-ipsTooltip='{lang="edit_signature_options"}'>
					<i class='fa-solid fa-xmark' aria-hidden="true"></i> <i class='fa-solid fa-caret-down' aria-hidden="true"></i>
					<span class="ipsInvisible">{lang="edit_signature_options"}</span>
				</button>
				<i-dropdown popover id="elSigIgnore{$uniqid}_menu">
					<div class="iDropdown">
						<ul class="iDropdown__items">
							{{if member.member_id != $member->member_id AND $member->canBeIgnored()}}
								<li>
									<a href='{url="app=core&module=system&controller=ignore&do=ignoreType&type=signatures&member_id={$member->member_id}" seoTemplate="ignore" csrf="true"}' data-ipsMenuValue='oneSignature'>{lang="hide_members_signature" sprintf="$member->name"}</a>
								</li>
							{{endif}}
							<li>
								<a href='{url="app=core&module=system&controller=settings&do=toggleSigs" ref="(string) \IPS\Request::i()->url()" seoTemplate="settings" csrf="true"}' data-ipsMenuValue='allSignatures'>{lang="hide_all_signatures"}</a>
							</li>
						</ul>
					</div>
				</i-dropdown>
			</div>
		{{endif}}

		<div class='ipsRichText i-color_soft'>
			{$member->signature|raw}
		</div>
	</div>
{{endif}}