<ips:template parameters="$html, $actions, $id" />
<div class='ipsApprovalQueueItem'>
    {{if \is_array( $actions ) AND \count( $actions )}}
        <ul class='ipsButtons ipsButtons--end i-padding_2'>
            {{if isset( $actions['delete'] )}}
            <li>
                <a href="{$actions['delete']}" class="ipsButton ipsButton--text ipsButton--small i-color_negative" data-action="approvalQueueAction" data-type="delete"><i class="fa-solid fa-xmark" aria-hidden="true"></i><span>{lang="delete"}</span></a>
            </li>
            {{endif}}
            {{if isset( $actions['hide'] )}}
            <li>
                <a href="{$actions['hide']}" class="ipsButton ipsButton--text ipsButton--small i-color_negative" data-action="approvalQueueAction" data-type="hide"><i class="fa-solid fa-eye-low-vision" aria-hidden="true"></i><span>{lang="hide"}</span></a>
            </li>
            {{endif}}
            {{if isset( $actions['approve'] )}}
            <li>
                <a href="{$actions['approve']}" class="ipsButton ipsButton--small ipsButton--positive" data-action="approvalQueueAction" data-type="approve"><i class="fa-solid fa-check" aria-hidden="true"></i><span>{lang="approve"}</span></a>
            </li>
            {{endif}}
            <li>
                <div class='i-padding-inline_1'>
                    <input type='checkbox' data-role='moderation' name="moderate[{$id}]" data-actions="{expression="implode( ' ', array_keys( $actions ) )"}" data-state='' class="ipsInput ipsInput--toggle">
                </div>
            </li>
        </ul>
    {{endif}}
    {$html|raw}
</div>