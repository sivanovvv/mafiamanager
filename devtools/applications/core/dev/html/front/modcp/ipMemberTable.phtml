<ips:template parameters="$table, $headers, $rows, $quickSearch" />
<div data-baseurl="{$table->baseUrl}" data-resort='{$table->resortKey}' data-controller="core.global.core.table">
	{{if $table->pages > 1}}
		<div class='ipsButtonBar ipsButtonBar--top'>
			<div data-role="tablePagination" class='ipsButtonBar__pagination'>
				{template="pagination" group="global" app="core" location="global" params="$table->baseUrl, $table->pages, $table->page, $table->limit"}
			</div>
		</div>
	{{endif}}
	<div class="">
		<h2 class='ipsTitle ipsTitle--h4 ipsTitle--padding'>{lang="ips_used_member" sprintf="$table->extra->name"}</h2>
		<i-data>
			<ol class="ipsData ipsData--table ipsData--compact ipsData--zebra {{foreach $table->classes as $class}}{$class} {{endforeach}}">
				<li class='ipsData__item i-font-weight_600 i-color_soft'>
					<div class='ipsData__content'>
						{{foreach $headers as $k => $header}}
							{{if $header !== '_buttons'}}
								<div class='i-basis_180'>{lang="{$table->langPrefix}{$header}"}</div>
							{{elseif $header === '_buttons'}}
								<div class='i-basis_180'></div>
							{{endif}}
						{{endforeach}}
					</div>
				</li>
				<li data-role="tableRows">
					{template="$table->rowsTemplate[1]" params="$table, $headers, $rows" object="$table->rowsTemplate[0]"}
				</li>
			</ol>
		</i-data>
		<div class='ipsButtonBar ipsButtonBar--bottom'>
			<div data-role="tablePagination" class='ipsButtonBar__pagination'>
				{template="pagination" group="global" app="core" location="global" params="$table->baseUrl, $table->pages, $table->page, $table->limit"}
			</div>
		</div>
	</div>
</div>