<ips:template parameters="$url, $filters, $activeFilter, $output" />
<div data-baseurl='{$url}' data-resort='topMembers' data-tableID='topMembers' data-controller='core.global.core.table'>
	<div class="ipsButtonBar ipsButtonBar--top">
		<div class='ipsButtonBar__end'>
			<ul class="ipsDataFilters">
				<li>
					<button type="button" id="elFilterByMenu" popovertarget="elFilterByMenu_menu" class='ipsDataFilters__button' data-role='tableFilterMenu'><span data-role="extraHtml">{$filters[ $activeFilter ]}</span> <i class="fa-solid fa-caret-down" aria-hidden="true"></i></button>
					<i-dropdown popover id="elFilterByMenu_menu" data-i-dropdown-selectable="radio">
						<div class="iDropdown">
							<ul class="iDropdown__items">
								{{foreach $filters as $k => $v}}
									<li>
										<a href='{$url->setQueryString( array( 'filter' => str_replace( array( 'IPS\\', '\\' ), array( '', '_' ), $k ) ) )}' rel="nofollow" data-action="tableFilter" data-ipsMenuValue='{expression="str_replace( array( 'IPS\\', '\\' ), array( '', '_' ), $k )"}' {{if $k === $activeFilter}}aria-selected="true"{{endif}}><i class="iDropdown__input" aria-hidden="true"></i>{$v}</a>
									</li>
								{{endforeach}}
							</ul>
						</div>
					</i-dropdown>
				</li>
			</ul>
		</div>
	</div>
	<section data-role="tableRows">
		{$output|raw}
	</section>
</div>
