<ips:template parameters="$id, $action, $elements, $hiddenValues, $actionButtons, $uploadField, $class='', $attributes=array(), $sidebar=NULL, $form=NULL" />

{{$exclude = array( 'q', 'joinedDate', 'joinedDateCustom', 'group');}}
{{$totalCustomFields = \count( $elements[''] ) - \count( $exclude ); // Don't count q, joined, joined custom or group}}
{{$perCol = ceil( $totalCustomFields / 2 );}}

{{if !\IPS\Request::i()->isAjax()}}
<form accept-charset='utf-8' class="ipsForm ipsForm--vertical ipsForm--member-filters" method='post' action='{$action}' data-ipsForm id='elSearchFilters_content'>
{{endif}}
	<input type="hidden" name="{$id}_submitted" value="1">
	{{foreach $hiddenValues as $k => $v}}
		<input type="hidden" name="{$k}" value="{$v}">
	{{endforeach}}

	<div class='i-padding_4'>
		<!--<div class='i-background_2 i-padding_3 i-margin-block_2 ipsPhotoPanel ipsPhotoPanel--mini'>
			<i class='fa-solid fa-user i-font-size_6' aria-hidden="true"></i>
			<div>
				<ul>
					{{if isset( $elements['']['q'] )}}
						<li class='i-margin-bottom_2'>
							<h3 class="ipsSideMenu__title">Search By Member Name</h3>
							<input type='text' name='q' value='{{if \is_array( $elements['']['q']->value )}}{expression="implode( ',', $elements['']['q']->value )"}{{else}}{$elements['']['q']->value}{{endif}}' class='ipsInput--primary ipsInput--wide'>
						</li>
					{{endif}}
				</ul>
			</div>
		</div>
		<hr class='ipsHr i-margin-bottom_4'>-->

		<div class='ipsSpanGrid'>
			<div class='ipsSpanGrid__4'>
				{{if isset( $elements['']['joinedDate'] )}}
					<h3 class="ipsSideMenu__title">Joined</h3>
					<ul class="ipsSideMenu__list" role="radiogroup" data-ipsSideMenu data-ipsSideMenu-type="radio" data-ipsSideMenu-responsive="false" data-filterType='joinedDate'>
						{{foreach $elements['']['joinedDate']->options['options'] as $k => $lang}}
							<li>
								<a href='#' class='ipsSideMenu_item {{if (string) $elements['']['joinedDate']->value == (string) $k}}ipsSideMenu_itemActive{{endif}}' data-ipsMenuValue='{$k}'>
									<input type="radio" class="ipsSideMenu__toggle" name="joinedDate" value="{$k}" {{if (string) $elements['']['joinedDate']->value == (string) $k}}checked{{endif}} id="elRadio_joinedDate_{$k}">
									<label for='elRadio_joinedDate_{$k}' id='elField_joinedDate_label_{$k}'>{lang="$lang"}</label>
								</a>
							</li>
						{{endforeach}}
						<li class='ipsSpanGrid cStreamForm_dates i-background_2 i-padding_2 {{if $elements['']['joinedDate']->value !== 'custom'}}ipsJS_hide{{endif}}' data-role="dateForm">
							<div class='ipsSpanGrid__6'>
								<h4 class='ipsMinorTitle'>{lang="start"}</h4>
								<input type='date' class='ipsInput ipsInput--text' name='{$elements['']['joinedDateCustom']->name}[start]' data-control='date' data-role='start' value='{$elements['']['joinedDateCustom']->value['start']}'>	
							</div>
							<div class='ipsSpanGrid__6'>
								<h4 class='ipsMinorTitle'>{lang="end"}</h4>
								<input type='date' class='ipsInput ipsInput--text' name='{$elements['']['joinedDateCustom']->name}[end]' data-control='date' data-role='end' value='{$elements['']['joinedDateCustom']->value['end']}'>
							</div>
						</li>
					</ul>
				{{endif}}
			</div>
			<div class='ipsSpanGrid__8' data-role='searchFilters' id='elSearchFiltersMembers'>
				<div class='ipsSpanGrid'>
					<div class='ipsSpanGrid__6'>
						{{if isset( $elements['']['group'] )}}
							<h3 class="ipsSideMenu__title">{lang="group"}</h3>
							<ul class="ipsSideMenu__list" data-ipsSideMenu data-ipsSideMenu-type="check" data-ipsSideMenu-responsive="false" data-filterType='group'>
								{{foreach $elements['']['group']->options['options'] as $k => $group}}
									<li>
										<a href='#' class='ipsSideMenu_item {{if \is_array( $elements['']['group']->value ) AND \in_array( $k, $elements['']['group']->value )}}ipsSideMenu_itemActive{{endif}}' data-ipsMenuValue='{$k}'>
											<input type="checkbox" class="ipsSideMenu__toggle" name="group" value="{$k}" {{if \is_array( $elements['']['group']->value ) AND \in_array( $k, $elements['']['group']->value )}}checked{{endif}} id="elCheck_group_{$k}">
											<label for='elCheck_group_{$k}' id='elField_group_label_{$k}'>{$group|raw}</label>
										</a>
									</li>
								{{endforeach}}
							</ul>
						{{endif}}

						{{$countOne = 0;}}
						{{if $totalCustomFields > 1}}
							{{foreach $elements[''] as $id => $element}}
								{{if \in_array( $id, $exclude )}}
									{{continue;}}
								{{endif}}
								{{$countOne++;}}

								<hr class='ipsHr'>
								<h3 class="ipsSideMenu__title">{lang="$id"}</h3>
								<div class='ipsFieldRow--fullWidth'>
									{$element->html()|raw}
								</div>
								
								{{if $countOne >= $perCol}}
									{{break;}}
								{{endif}}
							{{endforeach}}
						{{endif}}
					</div>
					<div class='ipsSpanGrid__6'>
						{{$countTwo = 0;}}
						{{foreach $elements[''] as $id => $element}}
							{{if \in_array( $id, $exclude )}}
								{{continue;}}
							{{endif}}
							{{$countTwo++;}}

							{{if $countTwo <= $countOne}}
								{{continue;}}
							{{endif}}

							{{if $countTwo !== ( $countOne + 1 )}}
								<!-- HR except for first item -->
								<hr class='ipsHr'>
							{{endif}}

							<h3 class="ipsSideMenu__title">{lang="$id"}</h3>
							<div class='ipsFieldRow--fullWidth'>
								{$element->html()|raw}
							</div>
							
							{{if $countTwo >= $perCol}}
								{{break;}}
							{{endif}}
						{{endforeach}}
					</div>			
				</div>			
			</div>
		</div>
	</div>
	<div class='ipsSubmitRow cSearchFiltersSubmit'>
		<ul class='ipsButtons'>
			<li>
				<button type="button" class="ipsButton ipsButton--text" data-action="cancelFilters">{lang="cancel"}</button>
			</li>
			<li>
				<button type="submit" class="ipsButton ipsButton--primary" data-action="updateResults">{lang="update_results"}</button>
			</li>
		</ul>
	</div>
{{if !\IPS\Request::i()->isAjax()}}	
</form>
{{endif}}