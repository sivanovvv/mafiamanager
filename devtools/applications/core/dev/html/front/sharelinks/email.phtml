<ips:template parameters="$url, $title" />
<a href="mailto:?subject={$title}&body={$url}" rel='nofollow' class='ipsShareLink ipsShareLink--email' data-ipsTooltip='{lang="email_text"}'>
	<i class="fa-solid fa-envelope" aria-hidden="true"></i>
	<span class="ipsInvisible">{lang="email_text"}</span>
</a>