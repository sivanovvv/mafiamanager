<ips:template parameters="$groups, $userIsStaff=FALSE" />

<header class="ipsPageHeader ipsPageHeader--staff">
	<div class="ipsPageHeader__row">
		<div data-ips-hook="header" class="ipsPageHeader__primary">
			<h1 data-ips-hook="title" class='ipsPageHeader__title'>{lang="staff_directory"}</h1>
		</div>
		{{if $userIsStaff}}
			<ul data-ips-hook="buttons" class='ipsButtons'>
				<li>
					<a href="{url="app=core&module=staffdirectory&controller=directory&do=form" seoTemplate="staffdirectory"}" rel="nofollow" class='ipsButton ipsButton--primary' data-ipsDialog data-ipsDialog-title='{lang="leader_edit_mine"}'><i class='fa-solid fa-pencil' aria-hidden="true"></i><span>{lang="leader_edit_mine"}</span></a>
				</li>
			</ul>
		{{endif}}
	</div>
</header>

{{foreach $groups as $group}}
	{{$members = $group->members();}}
	{{if \count( $members )}}
		<section class='ipsBox cStaffDirectory'>
			<h2 class='ipsBox__header'>{$group->_title}</h2>
			<div class='ipsBox__content'>
			    <div class="ipsGrid ipsGrid--lines ipsGrid--staff{{if $group->template == 'layout_full'}}-directory-full i-basis_100p{{elseif $group->template == 'layout_half'}}-directory-half i-basis_300{{else}} i-basis_200{{endif}}">
			        {{foreach $members as $member}}
			            {template="$group->template" app="core" group="staffdirectory" location="front" params="$member"}
			        {{endforeach}}
			    </div>
			</div>
		</section>
	{{endif}}
{{endforeach}}