<ips:template parameters="$index, $report, $content" />
<div class="i-padding_3 i-text-align_center">
	<div class="i-font-size_2">{lang="automoderation_already_reported" htmlsprintf="\IPS\DateTime::ts( $report['date_reported'] )->html()"}</div>
	<div class="i-padding_3">
		<a data-confirm href="{$content->url()->setQueryString( array( 'do' => 'deleteReport', 'cid' => $report['id'] ) )->csrf()}" class='ipsButton ipsButton--primary'>{lang="automoderation_already_reported_delete"}</a>
	</div>
</div>