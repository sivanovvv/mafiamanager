<ips:template parameters="$form=null" />
<div class='i-padding_3 i-border-bottom_3'>
	<h2 class='ipsTitle ipsTitle--h3'>{lang="change_password"}</h2>
</div>

<div>
	{{if \IPS\Member::loggedIn()->passwordResetForced()}}
		<div class='i-padding_3'>
			<p class='ipsMessage ipsMessage--warning'>{lang="password_reset_required"}</p>
		</div>
    {{elseif isset( \IPS\Request::i()->success ) AND \IPS\Request::i()->success == 1}}
        <div class='i-padding_3'>
			<p class="ipsMessage ipsMessage--success">{lang="password_changed"}</p>
		</div>
	{{endif}}
	{{if $form}}
		{$form|raw}
	{{else}}
		<div class='i-padding_3'>
			<div>
				{lang="change_password_admin_1"}
			</div>
			<ol class='ipsList ipsList--bullets i-margin-top_3'>
				<li>{lang="change_password_admin_2"}</li>
				<li>{lang="change_password_admin_3" sprintf="\IPS\Member::loggedIn()->name"}</li>
				<li>{lang="change_password_admin_4"}</li>
				<li>{lang="change_password_admin_5"}</li>
			</ol>
		</div>
	{{endif}}
</div>