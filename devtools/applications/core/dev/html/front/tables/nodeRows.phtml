<ips:template parameters="$table, $headers, $rows" />
{{foreach $rows as $row}}
	{{$contentItemClass = $row::$contentItemClass;}}
	<li class="ipsData__item {{if method_exists( $row, 'tableClass' ) && $row->tableClass()}}ipsData__item--{$row->tableClass()}{{endif}}" {{if $contentItemClass::containerUnread( $row )}}data-ips-unread{{else}}data-ips-read{{endif}}>
		{{if method_exists( $row, 'tableIcon' )}}
			<div class='ipsData__icon'>
				{$row->tableIcon()|raw}
			</div>
		{{endif}}
		<div class='ipsData__content'>
			<div class='ipsData__main'>
				<h4 class='ipsData__title'>
					{{if $contentItemClass::containerUnread( $row )}}
						<span class='ipsBadge ipsBadge--new'>{lang="new"}</span>
					{{endif}}

					{{if $row->_locked}}
						<i class="fa-solid fa-lock" aria-hidden="true"></i>
					{{endif}}
					
					<a href='{$row->url()}'>
						{$row->_title}
					</a>
				</h4>
				<div class='ipsData__desc ipsTruncate_2'>
					{$row->_description}
				</div>
			</div>
			<ul class='ipsData__stats'>
				<li>
					<span>{number="$row->_items"}</span>
					<span>{lang="node_content_items" pluralize="$row->_items"}</span>
				</li>
				<li>
					<span>{number="$row->_comments"}</span>
					<span>{lang="node_content_comments" pluralize="$row->_comments"}</span>
				</li>
				<li>
					<span>{number="$row->_reviews"}</span>
					<span>{lang="node_content_reviews" pluralize="$row->_reviews"}</span>
				</li>
			</ul>
		</div>
		{{if $table->canModerate()}}
			<label class="ipsData__mod">
				<span class="ipsInvisible">{lang="mod_checkbox"}</span>
				<input type='checkbox' data-role='moderation' name="moderate[{$row->_id}]" data-actions="{expression="implode( ' ', $table->multimodActions( $row ) )"}" data-state='' class="ipsInput ipsInput--toggle">
			</label>
		{{endif}}
	</li>
{{endforeach}}