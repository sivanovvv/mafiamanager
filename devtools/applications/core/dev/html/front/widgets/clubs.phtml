<ips:template parameters="$clubs, $title=NULL, $layout='table', $isCarousel=false" />

{{if $title}}
	<header class='ipsWidget__header'>
		<h3>{$title}</h3>
		{{if $isCarousel}}
			{{$carouselID = 'widget--clubs_' . mt_rand();}}
			{template="carouselNavigation" group="global" app="core" params="$carouselID"}
		{{endif}}
	</header>
{{endif}}
<div class="ipsWidget__content">
	<i-data>
		<ul class='ipsData ipsData--{$layout} {{if $isCarousel}}ipsData--carousel{{endif}} ipsData--widget-clubs' {{if $isCarousel}}id='{$carouselID}' tabindex="0"{{endif}}>
			{{foreach $clubs as $club}}
				<li class='ipsData__item'>
					<a href="{$club->url()}" class="ipsLinkPanel" aria-hidden="true" tabindex="-1"><span>{$club->name}</span></a>
					<div class='ipsData__image'>{template="clubIcon" group="clubs" app="core" params="$club, 'fluid', ''"}</div>
					<div class="ipsData__content">
						<div class='ipsData__main'>
							<h4 class='ipsData__title'><a href='{$club->url()}'>{$club->name}</a></h4>
							<p class='ipsData__meta'>
								{lang="club_{$club->type}"}
								{{if $club->type !== $club::TYPE_PUBLIC}} &middot; {lang="club_members_count" pluralize="$club->members"}{{endif}}
							</p>
						</div>
					</div>
				</li>
			{{endforeach}}
		</ul>
	</i-data>
</div>