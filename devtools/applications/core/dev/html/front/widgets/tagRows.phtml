<ips:template parameters="$items, $layout='table', $isCarousel=false, $soloTag=false" />
{{if $isCarousel}}
	{{$carouselID = $soloTag ? $soloTag : 'widget-tags_' . mt_rand();}}
{{endif}}
<i-data>
    <ul class='ipsData ipsData--{$layout} ipsData--widget-tags {{if $isCarousel}}ipsData--carousel{{endif}}' {{if $isCarousel}}id='{$carouselID}' tabindex="0"{{endif}}>
        {{foreach $items as $item}}
            <li class='ipsData__item'>
                <a href="{$item->url( 'getPrefComment' )}" class="ipsLinkPanel" aria-hidden="true" tabindex="-1"><span>{$item->mapped( 'title' )}</span></a>
				{{if in_array($layout, array("wallpaper", "featured", "grid"))}}
					<div class="ipsData__image" aria-hidden="true">
						{{if $image = $item->primaryImage()}}
							<img src="{$image->url}" alt="{$item->title}" loading="lazy">
						{{else}}
							<i aria-hidden="true"></i>
						{{endif}}
					</div>
				{{else}}
					<div class='ipsData__icon'>
						{template="userPhoto" app="core" group="global" params="$item->author(), 'fluid'"}
					</div>
				{{endif}}
				<div class="ipsData__content">
					<div class='ipsData__main'>
						<div class='ipsData__title'>
							<h4><a href="{$item->url()}" title='{lang="view_this_topic" sprintf="$item->mapped( 'title' )"}'>{$item->mapped( 'title' )}</a></h4>
						</div>
						<div class='ipsData__desc ipsRichText' data-controller='core.front.core.lightboxedImages'>{$item->truncated()|raw}</div>
						<p class='ipsData__meta'>
						    {lang="byline_name_date" htmlsprintf="$item->author()->link( NULL, NULL, $item->isAnonymous() ), \IPS\DateTime::ts( $item->mapped('date') )->html(FALSE)"}
						</p>
					</div>
				</div>
			</li>
		{{endforeach}}
	</ul>
	{{if $isCarousel && !$soloTag}}
		{template="carouselNavigation" group="global" app="core" params="$carouselID"}
	{{endif}}
</i-data>