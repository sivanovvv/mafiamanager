<ips:template parameters="$realUrl, $linkUrl, $title, $mimeType, $id" />
<video controls class="ipsEmbeddedVideo" data-fileid="{$id}" data-controller="core.global.core.embeddedvideo" preload='metadata'>
	<source src="<fileStore.core_Attachment>/{$realUrl}" type="{$mimeType}">
	<a class="ipsAttachLink" href="{$linkUrl}">{$title}</a>
</video>