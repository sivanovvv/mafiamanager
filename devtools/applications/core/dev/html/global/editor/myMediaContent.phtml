<ips:template parameters="$files, $pagination, $url, $extension" />
<div data-controller='core.global.editor.mymediasection' data-url="{$url}&search=1">
	<div class='i-background_3 i-padding_2'>
		<input type="search" class="ipsInput ipsInput--text ipsInput--wide" placeholder="{lang="editor_media_search"}" data-role="myMediaSearch">
	</div>
	<div data-role="myMediaResults" data-extension="{$extension}">
		{template="myMediaResults" app="core" group="editor" location="global" params="$files, $pagination, $url, $extension"}
	</div>	
</div>