<ips:template parameters="$id, $headers, $rows, $action, $hiddenValues, $actionButtons, $langPrefix, $widths=array(), $manageable=TRUE, $checkAlls=array(), $checkAllRows=FALSE, $classes=array(), $showTooltips=FALSE, $squashFields=TRUE, $sortable=FALSE, $styledRowTitle=FALSE" />
<form accept-charset='utf-8' class="ipsForm" action="{$action}" method="post" data-ipsMatrix {{if $sortable}}data-ipsMatrix-sortable='true'{{endif}} data-ipsMatrix-manageable='{{if $manageable}}true{{else}}false{{endif}}' {{if $squashFields}}data-ipsMatrix-squashFields{{endif}}>
	<input type="hidden" name="{$id}_submitted" value="1">
	{{foreach $hiddenValues as $k => $v}}
		<input type="hidden" name="{$k}" value="{$v}">
	{{endforeach}}
	{{foreach $rows as $rowId => $row}}
		<input type='hidden' name='{$id}_matrixRows[{$rowId}]' data-matrixrowid='{$rowId}' value='1'>
	{{endforeach}}
	{{if $manageable}}
		{template="buttons" group="global" app="core" params="array( 'add' => array( 'link' => \IPS\Http\Url::internal( '#' ), 'icon' => 'plus', 'title' => 'add_button', 'class' => 'matrixAdd', 'data' => array( 'matrixID' => $id ) ) )"}
	{{endif}}
	<div class="ipsTableScroll">
		<table class='ipsTable ipsMatrix {{if \count( $classes )}}{expression="implode( ' ', $classes )"}{{endif}}' role='grid' data-matrixID='{$id}'>
			{template="matrixRows" group="forms" location="global" app="core" params="$headers, $rows, $langPrefix, $manageable, $widths, $checkAlls, $checkAllRows, $showTooltips, $sortable ? $id : FALSE, $styledRowTitle"}
		</table>
	</div>
	<div class="ipsSubmitRow">
		{{foreach $actionButtons as $button}}{$button|raw} {{endforeach}}
	</div>
</form>