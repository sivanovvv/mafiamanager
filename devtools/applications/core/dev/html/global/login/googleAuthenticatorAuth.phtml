<ips:template parameters="$waitUntil" />
<div id="elGoogleAuthenticator" data-controller="core.global.core.googleAuth" data-waitUntil="{$waitUntil}">
	<div class="i-padding_3 ipsRichText i-text-align_center">
		{lang="google_mfa_auth"}
	</div>
	<ul class="i-padding_2" data-role="codeInput">
		<li class="" id="google_authenticator_form_google_authenticator_setup_code">
			<div class="">
				<input type="text" name="google_authenticator_auth_code" value="" class="ipsInput ipsInput--text {{if request.google_authenticator_auth_code}}ipsField_error{{endif}}" autocomplete="one-time-code" >
				{{if request.google_authenticator_auth_code}}
					<p class="i-color_warning">{lang="google_mfa_invalid_code"}</p>
				{{endif}}
			</div>
		</li>
		<li class="i-margin-top_2">
			<button type='submit' class='ipsButton ipsButton--primary ipsButton--wide'>
				<i class='fa-solid fa-lock' aria-hidden="true"></i> {lang="google_submit_code"}
			</button>
		</li>
	</ul>
	<div class="i-text-align_center ipsHide" data-role="codeWaiting">
		<div class="ipsProgress ipsProgress--animated">
			<div class="ipsProgress__progress" data-role="codeWaitingProgress"></div>
		</div>
		<p class="i-font-size_-2">{lang="google_wait_for_code"}</p>
	</div>
</div>