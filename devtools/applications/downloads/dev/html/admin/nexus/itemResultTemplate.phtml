<ips:template parameters="$item" />
<div data-itemid="{$item->id}" data-role='contentItemRow'>
	<strong>{$item->mapped('title')}</strong>
	{{if $item->container()}}
		<em>{lang="item_selector_added_to_container" sprintf="$item->container()->_title"}</em>
	{{endif}}
	<br>
	<span class='i-color_soft'>{$item->author()->name} </span> &middot; {$item->priceToDisplay()}
</div>

