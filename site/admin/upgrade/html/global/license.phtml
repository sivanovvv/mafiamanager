<ips:template parameters="$form, $active" />
<section class="ipsInstaller__padding">
	<h2 class="ipsType_pageTitle i-margin-bottom_1">{lang="license"}</h2>
	<ul class="ipsList_checks">
		{{if $active === NULL}}
			<li class="fail">{lang="lkey_not_providen"}</li>
			<li>{$form|raw}</li>
		{{else}}
			<li class="fail">{lang="license_inactive"}</li>
		{{endif}}
	</ul>
</section>