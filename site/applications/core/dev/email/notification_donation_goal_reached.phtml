<ips:template parameters="$goal, $email" />
{$email->language->addToStack( "notification__donation_goal_reached_amount", FALSE, array( 'sprintf' => array( new \IPS\nexus\Money( $goal->goal, $goal->currency ), $email->language->addToStack( "nexus_donategoal_" . $goal->id ) ) ) )}
<br><br>
<table width='100%' cellpadding='0' cellspacing='0' border='0'>
	<tr>
		<td dir='{dir}'>
			<img src='{setting="base_url"}applications/core/interface/email/heart.png' width='80' height='80' alt=''>
			&nbsp; &nbsp; &nbsp;
			<img src='{setting="base_url"}applications/core/interface/email/money.png' width='80' height='80' alt=''>
			&nbsp; &nbsp; &nbsp;
			<img src='{setting="base_url"}applications/core/interface/email/tada.png' width='80' height='80' alt=''>
		</td>
	</tr>
</table>
<br><br>
{$email->language->addToStack("notification__donation_goal_thanks")}
<br><br>
<em class="color_soft" style="color:#4b4b4b;">&mdash; {setting="board_name"}</em>