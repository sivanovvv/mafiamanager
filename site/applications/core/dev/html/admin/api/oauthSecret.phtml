<ips:template parameters="$client, $secret, $bruteForce" />
{{if $client->type == 'wordpress'}}
	<p>{lang="oauth_wordpress_blurb"}</p>
	<div class="ipsBox i-margin-bottom_1">
		<h2 class="ipsBox__header">{lang="oauth_wordpress_app_settings"}</h2>
		<i-data>
			<ul class="ipsData ipsData--table ipsData--oauth-secret">
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_wordpress_application"}</strong>
					</span>
					<span>
						{lang="oauth_wordpress_application_val"}
					</span>
				</li>
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_wordpress_app_name"}</strong>
					</span>
					<span>
						{setting="board_name"}
					</span>
				</li>
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_client_id"}</strong>
					</span>
					<span>
						<code>{$client->client_id}</code>
						<button type="button" class="ipsButton ipsButton--inherit ipsButton--tiny" data-ipscopy data-ipscopy-text="{$client->client_id}">{lang="copy"}</button>
					</span>
				</li>
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_client_secret"}</strong>
					</span>
					<span>
						{{if $secret}}
							<code>{$secret}</code><br>
							<button type="button" class="ipsButton ipsButton--inherit ipsButton--tiny" data-ipscopy data-ipscopy-text="{$secret}">{lang="copy"}</button>
							<span class="i-color_warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {lang="oauth_client_secret_desc"}</span>
						{{else}}
							<span class="i-color_soft">{lang="hidden"}</span>
							{{if member.hasAcpRestriction( 'core', 'applications', 'oauth_secrets' )}}
								<br>
								<a href="{url="app=core&module=applications&controller=api&tab=oauth&do=view&client_id={$client->client_id}&newSecret=1" csrf="true"}" data-confirm data-confirmSubMessage="{lang="oauth_regenerate_warning"}">{lang="oauth_regenerate_secret"}</a>
							{{endif}}
						{{endif}}
					</span>
				</li>
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_wordpress_scope"}</strong>
					</span>
					<span>
						<code>email</code>
					</span>
				</li>
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_authorize_uri"}</strong>
					</span>
					<span>
						<code>{url="oauth/authorize/" base="interface" protocol="\IPS\Http\Url::PROTOCOL_HTTPS"}</code>
					</span>
				</li>
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_token_uri"}</strong>
					</span>
					<span>
						<code>{url="oauth/token/" base="interface" protocol="\IPS\Http\Url::PROTOCOL_HTTPS"}</code>
					</span>
				</li>
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_wordpress_user_uri"}</strong>
					</span>
					<span>
						{{if settings.use_friendly_urls and settings.htaccess_mod_rewrite}}
							<code>{expression="rtrim( \IPS\Settings::i()->base_url, '/' )"}/api/core/me</code>
						{{else}}
							<code>{expression="rtrim( \IPS\Settings::i()->base_url, '/' )"}/api/index.php?/core/me</code>
						{{endif}}
					</span>
				</li>
			</ul>
		</i-data>
	</div>
	<div class="ipsBox i-margin-bottom_1">
		<h2 class="ipsBox__header">{lang="oauth_wordpress_attribute_mapping"}</h2>
		<i-data>
			<ul class="ipsData ipsData--table ipsData--oauth-secret">
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_wordpress_map_email"}</strong>
					</span>
					<span>
						<code>email</code>
					</span>
				</li>
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_wordpress_map_name"}</strong>
					</span>
					<span>
						<code>name</code>
					</span>
				</li>
			</ul>
		</i-data>
	</div>
{{else}}
	<div class="ipsBox i-margin-bottom_1">
		<h2 class="ipsBox__header">{lang="oauth_client_credentials"}</h2>
		<i-data>
			<ul class="ipsData ipsData--table ipsData--oauth-secret">
				<li class="ipsData__item">
					<span class="i-basis_180">
						<strong>{lang="oauth_client_id"}</strong>
					</span>
					<span>
						<code>{$client->client_id}</code>
						<button type="button" class="ipsButton ipsButton--inherit ipsButton--tiny" data-ipscopy data-ipscopy-text="{$client->client_id}">{lang="copy"}</button>
					</span>
				</li>
				{{if $client->client_secret}}
					<li class="ipsData__item">
						<span class="i-basis_180">
							<strong>{lang="oauth_client_secret"}</strong>
						</span>
						<span class="i-flex_11">
							{{if $secret}}
									<code id="secret">{$secret}</code>
									 <button type="button" class="ipsButton ipsButton--inherit ipsButton--tiny" data-ipscopy data-ipscopy-text="{$secret}">{lang="copy"}</button>
									<br>
								<span class="i-color_warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {lang="oauth_client_secret_desc"}</span>
							{{else}}
								<span class="i-color_soft">{lang="hidden"}</span>
								{{if member.hasAcpRestriction( 'core', 'applications', 'oauth_secrets' )}}
									<br>
									<a href="{url="app=core&module=applications&controller=api&tab=oauth&do=view&client_id={$client->client_id}&newSecret=1" csrf="true"}" data-confirm data-confirmSubMessage="{lang="oauth_regenerate_warning"}">{lang="oauth_regenerate_secret"}</a>
								{{endif}}
							{{endif}}
						</span>
					</li>
				{{endif}}
			</ul>
		</i-data>
	</div>
	{{if $client->type != 'invision'}}
		<div class="i-margin-bottom_1">
			<div class="ipsBox">
				<h2 class="ipsBox__header">{lang="oauth_endpoint_details"}</h2>
				<i-data>
					<ul class="ipsData ipsData--table ipsData--oauth-secret">
						{{$grants = explode( ',', $client->grant_types );}}
						{{if \in_array( 'authorization_code', $grants ) or \in_array( 'token', $grants )}}
							<li class="ipsData__item">
								<span class="i-basis_180">
									<strong>{lang="oauth_authorize_uri"}</strong>
								</span>
								<span>
									<code>{url="oauth/authorize/" base="interface" protocol="\IPS\Http\Url::PROTOCOL_HTTPS"}</code><br>
									{{if \in_array( 'authorization_code', $grants ) and \in_array( 'token', $grants )}}
										<div class="i-color_soft i-margin-top_1">{lang="oauth_authorize_uri_desc_3"}</div>
									{{elseif \in_array( 'authorization_code', $grants )}}
										<div class="i-color_soft i-margin-top_1">{lang="oauth_authorize_uri_desc_1"}</div>
									{{else}}
										<div class="i-color_soft i-margin-top_1">{lang="oauth_authorize_uri_desc_2"}</div>
									{{endif}}
								</span>
							</li>
						{{endif}}
						{{if \in_array( 'authorization_code', $grants ) or \in_array( 'client_credentials', $grants ) or \in_array( 'password', $grants )}}
							<li class="ipsData__item">
								<span class="i-basis_180">
									<strong>{lang="oauth_token_uri"}</strong>
								</span>
								<span>
									<code>{url="oauth/token/" base="interface" protocol="\IPS\Http\Url::PROTOCOL_HTTPS"}</code><br>
									<div class="i-color_soft i-margin-top_1">{lang="oauth_token_uri_desc"}</div>
								</span>
							</li>
						{{endif}}
					</ul>
				</i-data>
			</div>
		</div>
	{{endif}}
{{endif}}

{{if $bruteForce}}
	<div class="ipsBox i-margin-bottom_1">
		<h2 class="ipsBox__header">{lang="oauth_brute_force"}</h2>
		<div class="i-color_soft i-padding_3">{lang="oauth_brute_force_desc"}</div>
		{$bruteForce|raw}
	</div>
{{endif}}