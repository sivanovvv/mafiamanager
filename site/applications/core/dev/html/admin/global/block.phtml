<ips:template parameters="$title, $content, $margins=TRUE, $class='', $id=NULL, $showTitle=FALSE" />
{{if $title and $showTitle}}
<div class='i-padding_3'>
	<h1 class='ipsTitle ipsTitle--h3'>{$title}</h1>
</div>
{{endif}}
<div data-template='block' class='{$class}' {{if $id !== NULL}}id="{$id}"{{endif}}>
	{$content|raw}
</div>