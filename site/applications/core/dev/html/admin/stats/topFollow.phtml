<ips:template parameters="$select, $pagination, $members, $total, $column, $activeTab" />
<h2 class="ipsBox__header" data-ips-template="topFollow">{lang="stats_{$activeTab}_desc"}</h2>
{{if trim( $pagination )}}
	{$pagination|raw}
{{endif}}
	<table class="ipsTable ipsTable_zebra">
		<thead>
			<tr>
				<th width="60"></th>
				<th>{lang="member"}</th>
				<th>{lang="count"}</th>
			</tr>
		</thead>
		<tbody>
			{{foreach $select as $row}}
				{{$member = \IPS\Member::constructFromData( $members[ $row[$column] ] );}}
				<tr>
					<td>{template="userPhoto" app="core" group="global" params="$member"}</td>
					<td>{$member->name}</td>
					<td>{$row['count']}</td>
				</tr>
			{{endforeach}}
		</tbody>
	</table>
	{$pagination|raw}
