<ips:template parameters="$login" />
<ul class='ipsForm ipsForm--vertical ipsForm--admin-login-form'>
	<li class="ipsFieldRow ipsFieldRow--fullWidth">
		<label class="ipsFieldRow__label" for="auth">{lang="email_address"}</label>
		<div class="ipsFieldRow__content">
			<input class="ipsInput" autofocus type="email" placeholder="{lang="email_address"}" name="auth" id="auth" {{if isset( \IPS\Request::i()->auth )}}value="{request="auth"}"{{endif}} autocomplete="email">
		</div>
	</li>
	<li class="ipsFieldRow ipsFieldRow--fullWidth">
		<label class="ipsFieldRow__label" for="password">{lang="password"}</label>
		<div class="ipsFieldRow__content">
			<input class="ipsInput" type="password" placeholder="{lang="password"}" name="password" id="password" {{if isset( \IPS\Request::i()->password )}}value="{request="password"}"{{endif}} autocomplete="current-password">
		</div>
	</li>
	<li class='ipsSubmitRow'>
		<button type='submit' name="_processLogin" value="usernamepassword" class='ipsButton ipsButton--primary ipsButton--wide'><i class='fa-solid fa-lock' aria-hidden="true"></i> {lang="login"}</button>
	</li>
</ul>
