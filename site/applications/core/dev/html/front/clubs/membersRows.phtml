<ips:template parameters="$club, $members" />
{{if \count( $members )}}
<ol class='ipsGrid ipsGrid--lines ipsGrid--clubs-members i-basis_240'>
	{{foreach $members as $member}}
		<li class='i-position_relative i-text-align_center i-padding_3 i-flex i-flex-direction_column i-gap_2' data-ips-js='memberCard'>
			<div class="i-flex i-justify-content_center">
				<div class="i-basis_140">
					{template="userPhotoFromData" group="global" app="core" params="$member['core_members']['member_id'], $member['core_members']['name'], $member['core_members']['members_seo_name'], \IPS\Member::photoUrl( $member['core_members'] ), 'fluid', ''"}
				</div>
			</div>
			<h3 class='i-font-weight_600 i-font-size_3 i-color_hard'>
				{$member['core_members']['name']}
			</h3>
			{{if $club->owner and $member['core_members']['member_id'] === $club->owner->member_id}}
				<div><span class="ipsBadge ipsBadge--positive cClubMemberStatus">{lang="club_owner"}</span></div>
			{{elseif $member['core_clubs_memberships']['status'] === \IPS\Member\Club::STATUS_LEADER}}
				<div><span class="ipsBadge ipsBadge--positive cClubMemberStatus">{lang="club_leader"}</span></div>
			{{elseif \in_array( $member['core_clubs_memberships']['status'], array( \IPS\Member\Club::STATUS_MODERATOR, \IPS\Member\Club::STATUS_EXPIRED_MODERATOR ) )}}
				<div><span class="ipsBadge ipsBadge--intermediary cClubMemberStatus">{lang="club_moderator"}</span></div>
			{{endif}}
			{{if $club->isLeader() and !\in_array( $member['core_clubs_memberships']['status'], array( \IPS\Member\Club::STATUS_REQUESTED ) ) and ( !$club->owner or $member['core_members']['member_id'] !== $club->owner->member_id )}}
				<button type="button" id="elMember{$member['core_members']['member_id']}Menu" popovertarget="elMember{$member['core_members']['member_id']}Menu_menu" class="ipsButton ipsButton--small ipsButton--soft ipsButton--icon ipsMemberCard_controls"><i class="fa-solid fa-gear" aria-hidden="true"></i> <i class='fa-solid fa-angle-down' aria-hidden="true"></i></button>
				<i-dropdown popover id="elMember{$member['core_members']['member_id']}Menu_menu">
					<div class="iDropdown">
						<ul class="iDropdown__items">
							{{if \in_array( $member['core_clubs_memberships']['status'], array( \IPS\Member\Club::STATUS_DECLINED, \IPS\Member\Club::STATUS_BANNED ) )}}
								<li><a href="{$club->url()->setQueryString( array( 'do' => 'reInvite', 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-confirm>{lang="club_banned_invite"}</a></li>
							{{else}}
								{{if $club->isPaid() and $club->renewal_price}}
									{{if $member['nexus_purchases']['ps_expire'] or \in_array( $member['core_clubs_memberships']['status'], array( \IPS\Member\Club::STATUS_INVITED, \IPS\Member\Club::STATUS_WAITING_PAYMENT ) )}}
										<li><a href="{$club->url()->setQueryString( array( 'do' => 'bypassPayment', 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-confirm data-confirmSubMessage="{{if $member['core_clubs_memberships']['status'] === \IPS\Member\Club::STATUS_INVITED}}{lang="club_bypass_fee_renew_warn"}{{else}}{lang="club_bypass_fee_existing_warn"}{{endif}}">{lang="club_bypass_fee"}</a></li>
									{{elseif !$member['nexus_purchases']['ps_expire']}}
										<li><a href="{$club->url()->setQueryString( array( 'do' => 'restorePayment', 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-confirm {{if $member['nexus_purchases']['ps_expire'] === NULL and !\in_array( $member['core_clubs_memberships']['status'], array( \IPS\Member\Club::STATUS_INVITED_BYPASSING_PAYMENT ) )}}data-confirmSubMessage="{lang="club_restore_fee_no_purchase_warn"}"{{endif}}>{lang="club_restore_fee"}</a></li>
									{{endif}}
								{{endif}}
								{{if !\in_array( $member['core_clubs_memberships']['status'], array( \IPS\Member\Club::STATUS_INVITED, \IPS\Member\Club::STATUS_INVITED_BYPASSING_PAYMENT, \IPS\Member\Club::STATUS_WAITING_PAYMENT ) )}}
									{{if $member['core_clubs_memberships']['status'] === \IPS\Member\Club::STATUS_LEADER}}
										<li><a href="{$club->url()->setQueryString( array( 'do' => 'demoteLeader', 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-confirm>{lang="club_demote_leader"}</a></li>
									{{else}}
										<li><a href="{$club->url()->setQueryString( array( 'do' => 'makeLeader', 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-confirm data-confirmSubMessage="{lang="club_make_leader_confirm"}">{lang="club_make_leader"}</a></li>
									{{endif}}
									{{if \in_array( $member['core_clubs_memberships']['status'], array( \IPS\Member\Club::STATUS_MODERATOR, \IPS\Member\Club::STATUS_EXPIRED_MODERATOR ) )}}
										<li><a href="{$club->url()->setQueryString( array( 'do' => 'demoteModerator', 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-confirm>{lang="club_demote_moderator"}</a></li>
									{{elseif \IPS\Settings::i()->clubs_modperms != -1}}
										<li><a href="{$club->url()->setQueryString( array( 'do' => 'makeModerator', 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-confirm data-confirmSubMessage="{lang="club_make_moderator_confirm"}">{lang="club_make_moderator"}</a></li>
									{{endif}}
									<li><a href="{$club->url()->setQueryString( array( 'do' => 'removeMember', 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-confirm data-confirmSubMessage="{lang="club_remove_member_confirm"}">{lang="club_remove_member"}</a></li>
								{{else}}
									<li><a href="{$club->url()->setQueryString( array( 'do' => 'removeMember', 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-confirm data-confirmSubMessage="{{if $member['core_clubs_memberships']['status'] === \IPS\Member\Club::STATUS_INVITED}}{lang="club_remove_accepted_confirm"}{{else}}{lang="club_remove_invitation_confirm"}{{endif}}">{lang="club_remove_invitation"}</a></li>
									<li><a href="{$club->url()->setQueryString( array( 'do' => 'resendInvite', 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-confirm>{lang="club_resend_invitation"}</a></li>
								{{endif}}
							{{endif}}
						</ul>
					</div>
				</i-dropdown>
			{{endif}}

			<div>
				<h4 class='i-font-weight_600'>
					{{if $member['core_clubs_memberships']['status'] === \IPS\Member\Club::STATUS_REQUESTED}}
						{lang="club_date_joined_request"}
					{{elseif \in_array( $member['core_clubs_memberships']['status'], array( \IPS\Member\Club::STATUS_INVITED, \IPS\Member\Club::STATUS_INVITED_BYPASSING_PAYMENT ) )}}
						{lang="club_date_joined_invite"}
					{{else}}
						{lang="club_date_joined"}
					{{endif}}
				</h4>
				<p>
					{expression="\IPS\DateTime::ts( $member['core_clubs_memberships']['joined'] )->relative()"}
				</p>
			</div>

			{{if $club->isLeader()}}
				{{if $club->isPaid() and $club->renewal_price}}
					{{if $member['core_clubs_memberships']['status'] === \IPS\Member\Club::STATUS_INVITED_BYPASSING_PAYMENT}}
						<p class=''>
							{lang="club_fee_waived"}
						</p>
					{{elseif \in_array( $member['core_clubs_memberships']['status'], array( \IPS\Member\Club::STATUS_MEMBER, \IPS\Member\Club::STATUS_EXPIRED, \IPS\Member\Club::STATUS_MODERATOR, \IPS\Member\Club::STATUS_EXPIRED_MODERATOR ) )}}
						<hr class='ipsHr ipsHr--small'>
						<h4 class='i-color_soft'>
							{lang="club_membership_renews"}
						</h4>
						<p class=''>
							{{if $member['nexus_purchases']['ps_expire']}}
								{{if !$member['nexus_purchases']['ps_active']}}
								<span class="i-color_warning">
								{{endif}}
								{datetime="$member['nexus_purchases']['ps_expire']"}
								{{if !$member['nexus_purchases']['ps_active']}}
								</span>
								{{endif}}
							{{else}}
								{lang="never"}
							{{endif}}
						</p>
					{{endif}}
				{{endif}}
				{{if ( $member['added_by']['name'] or $member['invited_by']['name'] )}}
					<hr class='ipsHr ipsHr--small'>
					<p class='i-color_soft'>
						{{if \in_array( $member['core_clubs_memberships']['status'], array( \IPS\Member\Club::STATUS_DECLINED, \IPS\Member\Club::STATUS_BANNED ) )}}
							{{if $member['added_by']['name']}}
								{{if $member['core_clubs_memberships']['status'] === \IPS\Member\Club::STATUS_BANNED}}
									{lang="club_banned_by" sprintf="$member['added_by']['name']"}
								{{else}}
									{lang="club_declined_by" sprintf="$member['added_by']['name']"}
								{{endif}}
							{{else}}
								{{if $member['core_clubs_memberships']['status'] === \IPS\Member\Club::STATUS_BANNED}}
									{lang="club_banned"}
								{{else}}
									{lang="club_declined"}
								{{endif}}
							{{endif}}
						{{else}}
							{{if $member['invited_by']['name']}}
								{lang="club_invited_by" sprintf="$member['invited_by']['name']"}
							{{else}}
								{lang="club_added_by" sprintf="$member['added_by']['name']"}
							{{endif}}
						{{endif}}
					</p>
				{{endif}}
			{{endif}}


			{{if $club->isLeader() && $member['core_clubs_memberships']['status'] === \IPS\Member\Club::STATUS_REQUESTED}}
				<hr class='ipsHr ipsHr--small'>
				<ul class='i-flex i-gap_1 ipsMemberCard_buttons'>
					<li class='i-flex_11'>
						{{if $club->isPaid()}}
							<ul class="ipsButtons">
								<li>
									<a href="{$club->url()->setQueryString( array( 'do' => 'acceptRequest', 'member' => $member['core_members']['member_id'] ) )->csrf()}" class="ipsButton ipsButton--positive" data-ipsTooltip title='{lang="club_accept_request"}' data-action='requestApprove'>
										<i class='fa-solid fa-check' aria-hidden="true"></i>
									</a>
								</li>
								<li>
									<button type="button" id="elMember{$member['core_members']['member_id']}AcceptMenu" popovertarget="elMember{$member['core_members']['member_id']}AcceptMenu_menu" class="ipsButton ipsButton--positive ipsButton--icon"><i class='fa-solid fa-caret-down' aria-hidden="true"></i></button>
									<i-dropdown popover id="elMember{$member['core_members']['member_id']}AcceptMenu_menu" data-role="acceptMenu">
										<div class="iDropdown">
											<ul class="iDropdown__items">
												<li><a href="{$club->url()->setQueryString( array( 'do' => 'acceptRequest', 'waiveFee' => 1, 'member' => $member['core_members']['member_id'] ) )->csrf()}" data-action='requestApprove'>{lang="club_bypass_fee"}</a></li>
											</ul>
										</div>
									</i-dropdown>
								</li>
							</ul>
						{{else}}
							<a href="{$club->url()->setQueryString( array( 'do' => 'acceptRequest', 'member' => $member['core_members']['member_id'] ) )->csrf()}" class="ipsButton ipsButton--positive ipsButton--wide" data-ipsTooltip title='{lang="club_accept_request"}' data-action='requestApprove'><i class='fa-solid fa-check' aria-hidden="true"></i></a>
						{{endif}}
					</li>
					<li class='i-flex_11'>
						<a href="{$club->url()->setQueryString( array( 'do' => 'declineRequest', 'member' => $member['core_members']['member_id'] ) )->csrf()}" class="ipsButton ipsButton--negative ipsButton--wide" data-ipsTooltip title='{lang="club_decline_request"}' data-action='requestDecline'><i class='fa-solid fa-xmark' aria-hidden="true"></i></a>
					</li>
				</ul>
			{{endif}}
		</li>
	{{endforeach}}
</ol>
{{else}}
	<div class="ipsEmptyMessage">{lang="no_results"}</div>
{{endif}}
