<ips:template parameters="$item, $showContent=FALSE, $otherInfo=NULL" />

<h3 class='ipsRichEmbed_itemTitle ipsTruncate_1'>
	<a href='{$item->url( "getPrefComment" )}' title="{$item->mapped('title')}">{$item->mapped('title')}</a>
</h3>
{{if $showContent}}
	<div class='ipsRichEmbed__snippet'>
		{$item->truncated(TRUE)|raw}
	</div>
{{endif}}
{{if $otherInfo}}
	{$otherInfo|raw}
{{endif}}
<ul class='ipsList ipsList--inline i-color_soft i-link-color_inherit i-margin-top_2 i-gap_1'>
	<li class='ipsRichEmbed_commentPhoto'>
		{template="userPhoto" group="global" app="core" params="$item->author(), 'tinier'"}
	</li>
	<li>
		<a href='{$item->url()->setQueryString( 'do', 'getFirstComment' )}'>
			{lang="byline_name_date" htmlsprintf="$item->author()->name, \IPS\DateTime::ts( $item->mapped('date') )->html(TRUE)"}
		</a>
	</li>
	{{if $item::$commentClass}}
		<li class="i-margin-start_auto">
			<a href='{$item->url()->setQueryString( 'do', 'getLastComment' )}'>
				{{if $item::$firstCommentRequired}}
					<i class='fa-solid fa-comment' aria-hidden="true"></i> {lang="num_replies" pluralize="$item->mapped('num_comments') - 1"}
				{{else}}
					<i class='fa-solid fa-comment' aria-hidden="true"></i> {lang="num_comments" pluralize="$item->mapped('num_comments')"}
				{{endif}}
			</a>
		</li>
	{{endif}}
</ul>