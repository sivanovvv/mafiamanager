<ips:template parameters=" " />
<ul data-ips-hook="mobileNavHeader" class='ipsMobileNavIcons ipsResponsive_header--mobile'>
	{{if !\IPS\Member::loggedIn()->member_id}}
		<li data-el='guest'>
			<button type="button" class="ipsMobileNavIcons__button ipsMobileNavIcons__button--primary" popovertarget='ipsOffCanvas--guest'>
				<span>{lang="sign_in_short"}</span>
			</button>
		</li>
	{{endif}}
	{{if \IPS\Member::loggedIn()->member_id and cssvar.set__i-mobile-icons-location == "header"}}
		{{$defaultStream = \IPS\core\Stream::defaultStream();}}
		{{if \IPS\Member::loggedIn()->canAccessModule( \IPS\Application\Module::get( 'core', 'discover' ) ) }}
			<li data-el="discover">
				<a class="ipsMobileNavIcons__button" data-action="defaultStream" href='{{if $defaultStream}}{$defaultStream->url()}{{endif}}'>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path d="M64 464c-8.8 0-16-7.2-16-16V64c0-8.8 7.2-16 16-16H224v80c0 17.7 14.3 32 32 32h80V448c0 8.8-7.2 16-16 16H64zM64 0C28.7 0 0 28.7 0 64V448c0 35.3 28.7 64 64 64H320c35.3 0 64-28.7 64-64V154.5c0-17-6.7-33.3-18.7-45.3L274.7 18.7C262.7 6.7 246.5 0 229.5 0H64zm56 256c-13.3 0-24 10.7-24 24s10.7 24 24 24H264c13.3 0 24-10.7 24-24s-10.7-24-24-24H120zm0 96c-13.3 0-24 10.7-24 24s10.7 24 24 24H264c13.3 0 24-10.7 24-24s-10.7-24-24-24H120z"/></svg>
					<span class="ipsInvisible" data-role="defaultStreamName">{{if $defaultStream}}{$defaultStream->_title}{{endif}}</span>
				</a>
			</li>
		{{endif}}
	{{endif}}
	{{if \IPS\Member::loggedIn()->canAccessModule( \IPS\Application\Module::get( 'core', 'search' ) )}}
		{{if cssvar.set__i-mobile-icons-location == "header"}}
			<li data-el="search">
				<button type="button" class="ipsMobileNavIcons__button" popovertarget='ipsOffCanvas--search'>
					<svg xmlns="http://www.w3.org/2000/svg" height="16" width="16" viewBox="0 0 512 512"><path d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z"/></svg>
					<span class="ipsInvisible">{lang="search"}</span>
				</button>
			</li>
		{{endif}}
	{{endif}}
    {expression="\IPS\Member::loggedIn()->mobileNav( 'header' )" raw="true"}
	{{if \IPS\Member::loggedIn()->member_id }}
		<li data-el='user'>
			<button type="button" class="ipsMobileNavIcons__button" popovertarget='ipsOffCanvas--profile'>
				{{if cssvar.set__i-mobile-icons-location == "header"}}
					<span class="ipsInvisible">{member="name"}</span>
				{{else}}
					<span class="ipsMobileNavIcons__username">{member="name"}</span>
				{{endif}}
				<span class='ipsUserPhoto'>
					<img src='{expression="\IPS\Member::loggedIn()->photo"}' alt='' loading="lazy">
				</span>
				{{if cssvar.set__i-mobile-icons-location == "header"}}
					{{$total = \IPS\Member::loggedIn()->notification_cnt;}}
					{{if !\IPS\Member::loggedIn()->members_disable_pm and \IPS\Member::loggedIn()->canAccessModule( \IPS\Application\Module::get( 'core', 'messaging' ) )}}
						{{$total += \IPS\Member::loggedIn()->msg_count_new;}}
					{{endif}}
					{{if $total}}
						<span class='ipsNotification'>{$total}</span>
					{{endif}}
				{{endif}}
			</button>
		</li>
	{{endif}}
	{{if cssvar.set__i-mobile-icons-location == "header"}}
		<li data-el="more">
			<button type="button" class="ipsMobileNavIcons__button" popovertarget='ipsOffCanvas--navigation'>
				<svg xmlns="http://www.w3.org/2000/svg" height="16" width="14" viewBox="0 0 448 512"><path d="M0 96C0 78.3 14.3 64 32 64H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 128 0 113.7 0 96zM0 256c0-17.7 14.3-32 32-32H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32zM448 416c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32H416c17.7 0 32 14.3 32 32z"/></svg>
				<span class="ipsInvisible">Menu</span>
				{{$notificationCount= \IPS\Member\UserMenu::mobileNotificationCount();}}
                {{if $notificationCount}}
                    <span class='ipsNotification'>{$notificationCount}</span>
                {{endif}}
			</button>
		</li>
	{{endif}}
</ul>