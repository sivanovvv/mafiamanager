<ips:template parameters="$items, $preview=FALSE" />
{{foreach $items as $item}}
	{{if $preview or ( $item->canView() and $item->isAvailableFor( \IPS\Theme::i()->getLayoutValue('global_view_mode') === 'side' ? 'sidebar' : 'header' ) )}}
		{{if $children = $item->children()}}
			<li>
				<details>
					<summary>
						<span class="ipsNavBar__icon" aria-hidden="true">
							{{if $item->getIconData()}}
								{$item->getIconData()|raw}
							{{else}}
								<i class="fa-solid" style="--icon:'{$item->getDefaultIcon()|raw}'" aria-hidden="true"></i>
							{{endif}}
						</span>
						<span class="ipsNavBar__text">
							<span class="ipsNavBar__label">{$item->title()}</span>
							<i class="fa-solid fa-angle-down" aria-hidden="true"></i>
						</span>
					</summary>
					<i-details-content>
						<ul class='ipsNav__dropdown' id='elNavSecondary_{$item->id}'>
							{template="navBarChildren" app="core" group="global" location="front" params="$children"}
						</ul>
					</i-details-content>
				</details>
			</li>
		{{elseif $item instanceof \IPS\core\extensions\core\FrontNavigation\MenuHeader}}
			<li class='ipsNav__dropdownTitle'>
				{$item->title()}
			</li>
		{{elseif $item instanceof \IPS\core\extensions\core\FrontNavigation\MenuSeparator}}
			<li>
				<hr>
			</li>
		{{elseif $item instanceof \IPS\core\extensions\core\FrontNavigation\MenuButton}}
			<li>
				<a href='{$item->link()}'>
					<span class="ipsNavBar__icon" aria-hidden="true">
						<i class="fa-solid" style="--icon:'\\f061'" aria-hidden="true"></i>
					</span>
					<span class="ipsNavBar__text">
						<span class="ipsNavBar__label">{$item->title()}</span>
					</span>
				</a>
			</li>
		{{else}}
			<li {$item->attributes()|raw}>
				<a href='{$item->link()}' {{if method_exists( $item, 'target' ) AND $item->target()}}target='{$item->target()}'{{if $item->target() == '_blank'}} rel="noopener"{{endif}}{{endif}}>
					<span class="ipsNavBar__icon" aria-hidden="true">
						{{if $item->getIconData()}}
							{$item->getIconData()|raw}
						{{else}}
							<i class="fa-solid" style="--icon:'{$item->getDefaultIcon()|raw}'" aria-hidden="true"></i>
						{{endif}}
					</span>
					<span class="ipsNavBar__text">
						<span class="ipsNavBar__label">{$item->title()}</span>
					</span>
				</a>
			</li>
		{{endif}}
	{{endif}}
{{endforeach}}