<ips:template parameters="$contentURL, $lang, $names" />
{{$id = 'i-tooltip-' . mt_rand();}}
{{if \IPS\Content\Reaction::isLikeMode()}}
<a href='{$contentURL}' data-ipsDialog data-ipsDialog-destructOnClose data-ipsDialog-size='medium' data-ipsDialog-title='{lang="like_log_title"}' data-ipsTooltip data-ipstooltip-source="{$id}">{$lang} <span id="{$id}" hidden>{$names|raw}</span></a>
{{else}}
<a href='{$contentURL}' data-ipsDialog data-ipsDialog-destructOnClose data-ipsDialog-size='medium' data-ipsDialog-title='{lang="see_who_reacted"}' data-ipsTooltip data-ipstooltip-source="{$id}">{$lang} <span id="{$id}" hidden>{$names|raw}</span></a>
{{endif}}