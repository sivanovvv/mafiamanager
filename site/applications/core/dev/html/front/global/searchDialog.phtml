<ips:template parameters="" />
{{if ( \IPS\Settings::i()->site_online || \IPS\Member::loggedIn()->group['g_access_offline'] ) and \IPS\Member::loggedIn()->canAccessModule( \IPS\Application\Module::get( 'core', 'search' ) )}}
<dialog class='ipsSearchDialog' id='ipsSearchDialog' aria-labelledby="ipsSearchDialog__title">
	<button class='ipsSearchDialog__dismiss' command="close" commandfor="ipsSearchDialog" type="button">
		<span>{lang="search_trigger"}</span>
	</button>
	<search role="search">
		<p id='ipsSearchDialog__title' class='ipsInvisible'>{lang="search"}</p>
		<form class='ipsSearchDialog__modal' accept-charset='utf-8' action='{url="app=core&module=search&controller=search&do=quicksearch" seoTemplate="search" noprotocol="true"}' method='post'>
			<div class='ipsSearchDialog__input' data-ips-hook='searchInput'>
				<input type='text' id='ipsSearchDialog__input' placeholder='{lang="search_placeholder"}' name='q' autocomplete='off' aria-label='{lang="search"}' autofocus>
				<button type='submit' class="ipsButton ipsButton--primary"><span>{lang="search"}</span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
			</div>
			<div class='ipsSearchDialog__filters ipsFluid i-gap_lines' data-ips-hook='searchFilters'>
				<div>
					<label for='search-modal__type' class='ipsInvisible'>{lang="search_by_content_type"}</label>
					<div class='ipsSimpleSelect'>
						<i class="fa-regular fa-file-lines" aria-hidden="true"></i>
						<select name="type" id="search-modal__type">
							{{$option = \IPS\Output::i()->defaultSearchOption;}}
							<option value="all" {{if \IPS\Output::i()->defaultSearchOption[0] == 'all'}} selected{{endif}}>{lang="everywhere"}</option>
							{{if \count( output.contextualSearchOptions )}}
								{{foreach array_reverse( output.contextualSearchOptions ) as $name => $data}}
									<option value='contextual_{expression="json_encode( $data )"}' {{if \IPS\Output::i()->defaultSearchOption[0] == $data['type']}}selected{{endif}}>{lang="$name"}</option>
								{{endforeach}}
							{{endif}}
							{{foreach output.globalSearchMenuOptions() as $type => $name}}
								<option value="{$type}" {{if empty(\IPS\Output::i()->contextualSearchOptions) and \IPS\Output::i()->defaultSearchOption[0] == $type}}selected{{endif}}>{lang="$name"}</option>
							{{endforeach}}
						</select>
					</div>
				</div>
				<div>
					<label for='search-modal__find-results-in' class='ipsInvisible'>{lang="searchIn"}</label>
					<div class='ipsSimpleSelect'>
						<i class="fa-regular fa-file-lines" aria-hidden="true"></i>
						<select name="search_in" id="search-modal__find-results-in">
							<option value="all" selected>{lang="search_modal_titles_and_body"}</option>
							<option value="titles">{lang="search_modal_titles"}</option>
						</select>
					</div>
				</div>
				<div>
					<label for='search-modal__date-created' class='ipsInvisible'>{lang="startDate"}</label>
					<div class='ipsSimpleSelect'>
						<i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
						<select name="startDate" id="search-modal__date-created">
							<option value="any" selected>{lang="search_modal_created_any"}</option>
							<option value="day">{lang="search_modal_created_day"}</option>
							<option value="week">{lang="search_modal_created_week"}</option>
							<option value="month">{lang="search_modal_created_month"}</option>
							<option value="six_months">{lang="search_modal_created_six_months"}</option>
							<option value="year">{lang="search_modal_created_year"}</option>
						</select>
					</div>
				</div>
				<div>
					<label for='search-modal__last-updated' class='ipsInvisible'>{lang="updatedDate"}</label>
					<div class='ipsSimpleSelect'>
						<i class="fa-regular fa-calendar" aria-hidden="true"></i>
						<select name="updatedDate" id="search-modal__last-updated">
							<option value="any" selected>{lang="search_modal_updated_any"}</option>
							<option value="day">{lang="search_modal_updated_day"}</option>
							<option value="week">{lang="search_modal_updated_week"}</option>
							<option value="month">{lang="search_modal_updated_month"}</option>
							<option value="six_months">{lang="search_modal_updated_six_months"}</option>
							<option value="year">{lang="search_modal_updated_year"}</option>
						</select>
					</div>
				</div>
			</div>
		</form>
	</search>
</dialog>
{{endif}}