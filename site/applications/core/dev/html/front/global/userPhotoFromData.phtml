<ips:template parameters="$id, $name, $seoName, $photoUrl, $size='small', $classes='', $hovercard=TRUE" />
{{if $id and \IPS\Member::loggedIn()->canAccessModule( \IPS\Application\Module::get( 'core', 'members' ) )}}
	<a data-ips-hook="userPhotoWithUrl" href="{url="app=core&module=members&controller=profile&id={$id}" seoTemplate="profile" seoTitle="$seoName ?: \IPS\Http\Url::seoTitle( $name )"}" rel="nofollow" {{if $hovercard}}data-ipsHover data-ipsHover-target="{url="app=core&module=members&controller=profile&id={$id}&do=hovercard" seoTemplate="profile" seoTitle="$seoName ?: \IPS\Http\Url::seoTitle( $name )"}"{{endif}} class="ipsUserPhoto ipsUserPhoto--{$size}{{if $classes}} {$classes}{{endif}}" title="{lang="view_user_profile" sprintf="$name"}" aria-hidden="true" tabindex="-1">
		<img src='{$photoUrl}' alt='{$name}' loading="lazy">
	</a>
{{else}}
	<span data-ips-hook="userPhotoWithoutUrl" class='ipsUserPhoto ipsUserPhoto--{$size} {{if $classes}}{$classes}{{endif}}'>
		<img src='{$photoUrl}' alt='{$name}' loading="lazy">
	</span>
{{endif}}