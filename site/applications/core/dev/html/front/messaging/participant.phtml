<ips:template parameters="$map, $conversation" />
<li class='{{if !$map['map_user_active'] or $map['map_user_banned'] or \IPS\Member::load( $map['map_user_id'] )->members_disable_pm}}cMessage_leftConvo{{endif}}' data-participant="{$map['map_user_id']}">
	<div class='ipsPhotoPanel'>
		{template="userPhoto" app="core" group="global" params="\IPS\Member::load( $map['map_user_id'] ), 'fluid'"}
		<div class='ipsPhotoPanel__text'>
			<div class='ipsPhotoPanel__primary'>
				{{if $map['map_user_id'] == \IPS\Member::loggedIn()->member_id}}
					{member="name" id="$map['map_user_id']"}
				{{elseif !\IPS\Member::load( $map['map_user_id'] )->member_id}}
					{lang="messenger_deleted_member"}
				{{else}}
				<button type="button" id="elMessage{$conversation->id}_user{$map['map_user_id']}" popovertarget="elMessage{$conversation->id}_user{$map['map_user_id']}_menu" class="cMessage_name" data-role='userActions' data-username='{member="name" id="$map['map_user_id']"}'>{member="name" id="$map['map_user_id']"} <i class='fa-solid fa-caret-down' aria-hidden="true"></i></button>
				{{endif}}
			</div>
			<div class='ipsPhotoPanel__secondary i-font-size_-1'>
				<span data-role='userReadInfo'>
					{{if $map['map_user_banned']}}
						<span class="i-color_warning"><i class="fa-solid fa-ban" aria-hidden="true"></i> {lang="messenger_map_removed"}</span>
					{{elseif !$map['map_user_active']}}
						{{if $map['map_left_time']}}{lang="messenger_map_left"}{datetime="$map['map_left_time']"}{{else}}{lang="messenger_map_left_notime"}{{endif}}
					{{elseif \IPS\Member::load( $map['map_user_id'] )->members_disable_pm == 2}}
						<span title='{lang="messenger_map_disabled_desc" sprintf="\IPS\Member::load( $map['map_user_id'] )->name"}' data-ipsTooltip>{lang="messenger_map_disabled"}</span>
					{{else}}
						{{if $map['map_read_time']}}{lang="messenger_map_read"}{datetime="$map['map_read_time']"}{{else}}{lang="messenger_map_not_read"}{{endif}}
					{{endif}}
				</span>
			</div>
		</div>
	</div>
	{{if $map['map_user_id'] != \IPS\Member::loggedIn()->member_id and \IPS\Member::load( $map['map_user_id'] )->member_id}}
		<i-dropdown popover id="elMessage{$conversation->id}_user{$map['map_user_id']}_menu">
			<div class="iDropdown">
				<ul class="iDropdown__items">
					{{if $conversation->starter_id == \IPS\Member::loggedIn()->member_id and ( $map['map_user_active'] or $map['map_user_banned'] )}}
						{{if $map['map_user_banned']}}
							<li><a href='{$conversation->url('addParticipant')->csrf()->setQueryString( 'member', $map['map_user_id'] )}' data-ipsMenuValue='unblock'>{lang="messenger_map_unremove"}</a></li>
						{{else}}
							<li><a href='{$conversation->url('blockParticipant')->csrf()->setQueryString( 'member', $map['map_user_id'] )}' data-ipsMenuValue='block'>{lang="messenger_map_remove"}</a></li>
						{{endif}}
						<li><hr></li>
					{{endif}}
					<li><a href='{url="app=core&module=messaging&controller=messenger&do=compose&to={$map['map_user_id']}" seoTemplate="messenger_compose"}' data-ipsDialog data-ipsDialog-title='{lang="compose_new"}' data-ipsMenuValue='msg'>{lang="messenger_map_message"}</a></li>
				</ul>
			</div>
		</i-dropdown>
	{{endif}}
</li>