<ips:template parameters="$table, $headers, $members" />
{{foreach $members as $member}}
	{{$loadedMember = \IPS\Member::load( $member->member_id );}}
	<li class='ipsData__item'>
		<div class='ipsData__icon'>
			{template="userPhoto" group="global" app="core" params="$loadedMember, 'medium'"}
		</div>
		<div class='ipsData__content'>
			<div class='ipsData__main'>
				<div class='ipsData__title'><h3>{$loadedMember->link()|raw}</h3> {{if $loadedMember->isOnline()}}<i class="ipsOnline" data-ipsTooltip title='{lang="online_now" sprintf="$member->name"}' aria-hidden="true"></i>{{endif}}</div>
				<span>{expression="\IPS\Member\Group::load( $member->member_group_id )->formattedName" raw="true"}</span>
				<ul class='ipsList ipsList--inline i-color_soft'>
					<li><strong>{lang="members_member_posts"}: {$loadedMember->member_posts}</strong></li>
					<li>{lang="members_joined"} {datetime="$loadedMember->joined"}</li>
					{{if $loadedMember->last_activity}}
						<li>{lang="members_last_visit"} {datetime="$loadedMember->last_activity"}</li>
					{{endif}}
				</ul>
			</div>
		</div>
		{{if $table->canModerate()}}
			<label class="ipsData__mod">
				<span class="ipsInvisible">{lang="mod_checkbox"}</span>
				<input type='checkbox' data-role='moderation' name="moderate[{$member->member_id}]" data-actions="{expression="implode( ' ', $table->multimodActions( $member ) )"}" data-state='' class="ipsInput ipsInput--toggle">
			</label>
		{{endif}}
	</li>
{{endforeach}}