<ips:template parameters="$member" />
<li class="ipsStreamItem ipsStreamItem_contentBlock ipsStreamItem_member i-padding_3 i-text-align_center">
	<div class='ipsStreamItem__mainCell'>
		<div class='i-text-align_center'>{template="userPhoto" group="global" app="core" params="$member, 'medium'"}</div>
		<div class='ipsStreamItem__header i-margin-top_2'>
			<h2 class='ipsStreamItem__title' data-searchable>
				{template="userLink" app="core" group="global" params="$member"}
			</h2>
			<p>{$member->groupName|raw}</p>
			{template="reputationBadge" group="global" app="core" params="$member"}
		</div>

		<ul class='ipsFluid i-text-align_center i-border-top_3 i-border-bottom_3 i-margin-block_2 i-padding-block_2'>
			<li>
				<h3 class='i-font-size_-1 i-font-weight_500'>{lang="joined"}</h3>
				<p class="i-color_hard">{datetime="$member->joined"}</p>
			</li>
			<li>
				<h3 class='i-font-size_-1 i-font-weight_500'>{lang="members_member_posts"}</h3>
				<p class="i-color_hard">{number="$member->member_posts"}</p>
			</li>
		</ul>

		<ul class='ipsButtons'>
			<li>
				<a href='{url="app=core&module=members&controller=profile&do=content&id={$member->member_id}" base="front" seoTemplate="profile_content" seoTitle="$member->members_seo_name"}' class='ipsButton ipsButton--soft'>{lang="find_content"}</a>
			</li>
			{{if \IPS\Member::loggedIn()->member_id != $member->member_id and ( !$member->members_bitoptions['pp_setting_moderate_followers'] or \IPS\Member::loggedIn()->following( 'core', 'member', $member->member_id ) )}}
				<li>
					{template="memberFollow" app="core" group="profile" params="'core', 'member', $member->member_id, $member->followersCount(), TRUE"}
				</li>
			{{endif}}
		</ul>
	</div>
</li>