<ips:template parameters="$results, $showTimeSeparators=FALSE, $sort='date', $view='expanded'" />
{{$currentSeparator = NULL;}}
{{if \count( $results )}}
	{{foreach $results as $result}}
		{{if $result !== NULL}}
			{{if $showTimeSeparators}}
				{{if $currentSeparator != 'earlier'}}
					{{$separator = $result->streamSeparator( $sort == 'date' );}}
					{{if $currentSeparator != $separator}}
						<li class="ipsPwaStickyFix ipsPwaStickyFix--ipsStreamTime"></li>
						<li class='ipsStream__time ipsTitle ipsTitle--h4' data-timeType='{$separator}'><h2>{lang="$separator"}</h2></li>
						{{$currentSeparator = $separator;}}
					{{endif}}
				{{endif}}
			{{endif}}
			{$result->html( $view, $sort != 'date', TRUE )|raw}
		{{endif}}
	{{endforeach}}
{{else}}
	{{if ! ( \IPS\Request::i()->isAjax() and isset( \IPS\Request::i()->before ) )}}
	<li class='i-text-align_center i-padding_2' data-role="streamNoResultsMessage">
		<p class='i-color_soft'>{lang="stream_no_results"}</p>
	</li>
	{{endif}}
{{endif}}