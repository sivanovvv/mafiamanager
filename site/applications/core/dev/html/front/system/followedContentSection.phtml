<ips:template parameters="$types, $currentAppModule, $currentType, $table" />
<div class='cFollowedContent'>
	<h2 class='i-font-size_3 i-font-weight_600 i-color_hard i-padding_2'>{{if is_subclass_of( $types[ $currentAppModule ][ $currentType ], 'IPS\Content\Item' )}}{lang="stuff_i_follow" sprintf="\IPS\Member::loggedIn()->language()->addToStack( $types[ $currentAppModule ][ $currentType ]::$title . '_pl' )"}{{elseif $types[ $currentAppModule ][ $currentType ] == "\IPS\Member"}}{lang="members_i_follow"}{{else}}{lang="stuff_i_follow" sprintf="\IPS\Member::loggedIn()->language()->addToStack( $types[ $currentAppModule ][ $currentType ]::$nodeTitle )"}{{endif}}</h2>
	{$table|raw}
</div>