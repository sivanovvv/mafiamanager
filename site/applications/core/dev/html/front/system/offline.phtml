<ips:template parameters="$message" />
<div id='ipsLayout_mainArea'>
	<div class='ipsBox ipsBox--offline' data-ips-hook="systemOffline">
		<div class="i-padding_3">
			<h1 class='ipsTitle ipsTitle--h1 i-margin-bottom_3'>{lang='offline_unavailable' sprintf='\IPS\Settings::i()->board_name'}</h1>
			<div class='ipsRichText'>
				{$message|raw}
			</div>
		</div>
		<div class='ipsSubmitRow'>
			{{if member.member_id}}
				<a href='{url="app=core&module=system&controller=login&do=logout" seoTemplate="logout" csrf="1"}' class='ipsButton ipsButton--primary'>{lang='sign_out'}</a>
			{{else}}
				<a href='{url="app=core&module=system&controller=login" seoTemplate="login"}' class='ipsButton ipsButton--primary'>{lang='login'}</a>
			{{endif}}
		</div>
	</div>
</div>