<ips:template parameters="$table, $headers, $rows" />
{{if \count( $rows )}} 
	{{foreach $rows as $row}}
		{{$member = \IPS\Member::load( $row['member_id'] );}}
		<li class='ipsData__item'>
			<a href='{$member->url()}' class="ipsLinkPanel" aria-hidden="true" tabindex="-1"><span>{member="name" id="$row['member_id']"}</span></a>
			<div class="ipsData__icon">
				{template="userPhoto" app="core" group="global" params="$member, 'tiny'"}	
			</div>
			<div class="ipsData__content">
				<div class="ipsData__main">
					<div class="ipsData__title"><a href="{$member->url()}">{member="name" id="$row['member_id']"}</a></div>
					<p class='ipsData__desc ipsData__desc--all'>{datetime="$row['joined']"}</p>
				</div>
			</div>
		</li>
	{{endforeach}}
{{endif}}
