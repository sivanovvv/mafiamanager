<ips:template parameters="$setting" />
<theme-setting data-setting='{$setting->key}' data-type='{$setting->type}' {{if $setting->refresh}}data-setting-refresh{{endif}}>
    <div class="theme-editor__align-setting">
        <label for='{$setting->key}__num'>{$setting->name}</label>
        <button class='theme-editor__revert' type='button' data-revert='{$setting->key}' {{if $setting->value() == $setting->defaultValue()}}hidden{{endif}} data-ipstooltip title='{lang="theme_editor_revert"}' data-on-click="revertSetting"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><span class="ipsInvisible">{lang="theme_editor_revert"}</span></button>
        <input type='number' inputmode='numeric' data-range-output='{$setting->key}' id='{$setting->key}__num' value='{$setting->value()|raw}' {{if isset( $setting->data['min'] )}}min="{$setting->data['min']}" {{endif}}{{if isset( $setting->data['max'] )}}max="{$setting->data['max']}" {{endif}}{{if isset( $setting->data['step'] )}}step="{$setting->data['step']}" {{endif}} data-on-change="syncInputsWithPseudo">
    </div>
    <input type='range' id='{$setting->key}' name='{$setting->key}' value='{$setting->value()|raw}' {{if isset( $setting->data['min'] )}}min="{$setting->data['min']}" {{endif}}{{if isset( $setting->data['max'] )}}max="{$setting->data['max']}" {{endif}}{{if isset( $setting->data['step'] )}}step="{$setting->data['step']}" {{endif}} data-default="{$setting->defaultValue()}" data-on-input="changingRangeInput" data-on-change="settingHasBeenChanged">
    {{if $desc = $setting->desc}}
        <small>{$desc|raw}</small>
    {{endif}}
</theme-setting>