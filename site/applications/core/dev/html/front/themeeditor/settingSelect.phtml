<ips:template parameters="$setting" />
<theme-setting data-setting='{$setting->key}' data-type='{$setting->type}' {{if $setting->refresh}}data-setting-refresh{{endif}}>
    <div class="theme-editor__align-setting">
        <label for='{$setting->key}'>{$setting->name}</label>
        <button class='theme-editor__revert' type='button' data-revert='{$setting->key}' {{if $setting->value() == $setting->defaultValue()}}hidden{{endif}} data-ipstooltip title='{lang="theme_editor_revert"}' data-on-click="revertSetting"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><span class="ipsInvisible">{lang="theme_editor_revert"}</span></button>
        <select id='{$setting->key}' name='{$setting->key}' data-default="{$setting->defaultValue()}" data-on-change="settingHasBeenChanged">
            {{foreach $setting->data['options'] as $option}}
                <option value='{$option[0]}' {{if $option[0] == $setting->value()}}selected{{endif}}>{$option[1]}</option>
            {{endforeach}}
        </select>
    </div>
    {{if $desc = $setting->desc}}
        <small>{$desc|raw}</small>
    {{endif}}
</theme-setting>