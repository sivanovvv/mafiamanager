<ips:template parameters="$url, $newWindow=TRUE, $title=NULL, $wordbreak=TRUE, $nofollow=FALSE, $noreferrer=FALSE, $titleRaw = FALSE" />
{{if $wordbreak}}<div class=''>{{endif}}
<a href='{$url}'{{if $newWindow === TRUE}} target='_blank' {{if $nofollow === FALSE}}rel="{{if $noreferrer}}noreferrer{{else}}noopener{{endif}}"{{endif}}{{endif}}{{if $nofollow === TRUE}} rel="nofollow{{if $newWindow === TRUE}} {{if $noreferrer}}noreferrer{{else}}noopener{{endif}}{{endif}}"{{endif}}>
	{{if $title}}
		{{if $titleRaw}}
			 {$title|raw}
		{{else}}
			{$title}
		{{endif}}
	{{else}}
		{$url}
	{{endif}}
</a>
{{if $wordbreak}}</div>{{endif}}