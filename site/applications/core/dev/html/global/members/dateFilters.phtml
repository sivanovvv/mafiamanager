<ips:template parameters="$dateRange, $element" />
<ul class='ipsFieldList'>
	<li>
		<input name="{$element->name}[2]" value='none' type='radio' {{if empty($element->value[0]) AND empty($element->value[1]) AND empty($element->value[3])}} checked{{endif}} class="ipsInput ipsInput--toggle">
		<div class='ipsFieldList__content'>
			{lang="any_time"}
		</div>
	</li>
	<li>
		<input name="{$element->name}[2]" value='range' type='radio'  data-control="toggle" data-toggles=""{{if $element->value[0]}} checked{{endif}} class="ipsInput ipsInput--toggle">
		<div class='ipsFieldList__content'>
			{$dateRange->html()|raw}
		</div>
	</li>
	<li class="i-margin-top_2">
		<input name="{$element->name}[2]" value='days' type='radio' {{if $element->value[1]}} checked{{endif}} class="ipsInput ipsInput--toggle">
		<div class='ipsFieldList__content'>
			{lang="or_more_than"}
			{template="number" location="global" app="core" group="forms" params="$element->name . '[1]', $element->value[1], $element->required, NULL, FALSE, 0, NULL, 1, 0, NULL, FALSE, \IPS\Member::loggedIn()->language()->addToStack( 'days_ago' ), array(), TRUE, array(), $element->name . '_number'"}
		</div>
	</li>
	<li class="i-margin-top_2">
		<input name="{$element->name}[2]" value='days_lt' type='radio' {{if ! empty( $element->value[3])}} checked{{endif}} class="ipsInput ipsInput--toggle">
		<div class='ipsFieldList__content'>
			{lang="or_less_than"}
			{template="number" location="global" app="core" group="forms" params="$element->name . '[3]', isset( $element->value[3] ) ? $element->value[3] : NULL, $element->required, NULL, FALSE, 0, NULL, 1, 0, NULL, FALSE, \IPS\Member::loggedIn()->language()->addToStack( 'days_ago' ), array(), TRUE, array(), $element->name . '_number_lt'"}
		</div>
	</li>
</ul>